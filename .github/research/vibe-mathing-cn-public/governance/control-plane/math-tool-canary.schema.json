{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecatlabs.com/vibe-mathing/math-tool-canary.schema.json",
  "title": "Bounded Math Tool Canary Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "scope", "runner", "execution_policy", "tools", "identities", "results", "summary"],
  "properties": {
    "schema_version": {"const": "math-tool-canary.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "scope": {"const": "synthetic-bounded-runtime"},
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sha256", "runtime_binding"],
      "properties": {
        "source": {"const": "scripts/run_math_tool_canaries.py"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_binding": {"const": "explicit-environment"}
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "memory_budget_mb", "threads_max", "max_output_bytes", "stop_condition", "termination"],
      "properties": {
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
        "memory_budget_mb": {"type": "integer", "minimum": 1, "maximum": 131072},
        "threads_max": {"type": "integer", "minimum": 1, "maximum": 1024},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 128000000},
        "stop_condition": {"type": "string", "minLength": 1},
        "termination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"enum": ["completed", "failed"]},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["T13", "T15", "T16"]}
    },
    "identities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "string", "minLength": 1}
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_id", "component", "kind", "status", "detail", "duration_seconds", "termination_status"],
        "properties": {
          "tool_id": {"enum": ["T13", "T15", "T16"]},
          "component": {"type": "string", "minLength": 2},
          "kind": {"enum": ["positive", "negative", "error", "timeout"]},
          "status": {"enum": ["PASS", "FAIL"]},
          "detail": {"type": "string", "minLength": 1, "maxLength": 160},
          "duration_seconds": {"type": "number", "minimum": 0},
          "termination_status": {"enum": ["completed", "failed", "timed_out", "cancelled"]}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "passed", "failed", "all_passed"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "all_passed": {"type": "boolean"}
      }
    }
  }
}
