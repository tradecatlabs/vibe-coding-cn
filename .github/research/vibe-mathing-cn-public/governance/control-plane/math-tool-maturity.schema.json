{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecatlabs.com/vibe-mathing/math-tool-maturity.schema.json",
  "title": "Math Tool Maturity Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of", "states", "tools"],
  "properties": {
    "schema_version": {"const": "math-tool-maturity.v1"},
    "as_of": {"type": "string", "format": "date"},
    "states": {
      "const": ["surveyed", "source_locked", "installed", "smoke_checked", "evidence_capable", "verifier_admitted"]
    },
    "tools": {
      "type": "array",
      "minItems": 41,
      "maxItems": 41,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_id", "family", "maturity", "runtime_route", "evidence_refs", "reason"],
        "properties": {
          "tool_id": {"type": "string", "pattern": "^T(?:0[1-9]|[1-3][0-9]|4[01])$"},
          "family": {"type": "string", "minLength": 2},
          "maturity": {"enum": ["surveyed", "source_locked", "installed", "smoke_checked", "evidence_capable", "verifier_admitted"]},
          "runtime_route": {"enum": ["none", "candidate-generation", "evidence", "verifier"]},
          "components": {"type": "array", "items": {"type": "string", "minLength": 2}, "uniqueItems": true},
          "admitted_components": {"type": "array", "items": {"type": "string", "minLength": 2}, "uniqueItems": true},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}, "uniqueItems": true},
          "reason": {"type": "string", "minLength": 8}
        }
      }
    }
  }
}
