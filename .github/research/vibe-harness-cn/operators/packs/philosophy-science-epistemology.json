  "metadata": {
    "id": "psoa.pack.philosophy-science-epistemology",
    "version": "1.0.0",
    "domain": "philosophy-science-epistemology",
    "title": "科学哲学与认识论",
    "summary": "把观察、解释、辅助假设、竞争理论和区分性证据转为受限推理程序。",
    "source_entry_count": 5,
    "derived_entry_count": 1
  },
  "entries": [
    {
      "id": "psoa.philosophy-science-epistemology.observation-interpretation-separation",
      "version": "1.0.0",
      "kind": "MentalModelSpec",
      "origin": "source",
      "source_key": "philosophy-science-epistemology.observation-interpretation-separation",
      "name": "Observation Interpretation Separation",
      "name_zh": "观察与解释分离",
      "domain": "philosophy-science-epistemology",
      "status": "experimental",
      "summary": "把可记录的观测、测量和材料与解释、背景理论和价值判断分开。",
      "core_question": "哪些是直接材料，哪些是对材料的解释？",
      "operation": "记录观察 → 标出测量条件 → 分离解释与背景假设 → 保留可替代解释。",
      "agent_use": "防止 Agent 把推断写成事实。",
      "applicability": {
        "when": [
          "结论同时依赖观测材料和理论解释。"
        ],
        "not_when": [
          "没有可辨认的观察或材料层。"
        ]
      },
      "source_refs": [
        "ref:sep-scientific-method",
        "ref:sep-science-theory-observation"
      ],
      "governance": {
        "risk_level": "low",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "questions": [
          "观测在什么条件下产生？",
          "哪些词是解释而非记录？"
        ],
        "interpretation_rules": [
          "保留原始观测和测量上下文",
          "每个解释列出依赖的背景假设",
          "允许多个解释并列"
        ],
        "limitations": [
          "观察本身也可能受仪器和概念框架影响。"
        ]
      }
    },
    {
      "id": "psoa.philosophy-science-epistemology.inference-to-best-explanation",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "source_key": "philosophy-science-epistemology.inference-to-best-explanation",
      "name": "Inference to the Best Explanation",
      "name_zh": "最佳解释推断",
      "domain": "philosophy-science-epistemology",
      "status": "experimental",
      "summary": "在多个候选解释间比较覆盖范围、一致性、简单性和预测力，但不把最佳解释当作已证真。",
      "core_question": "哪个解释在当前证据和标准下更有解释力，替代解释是什么？",
      "operation": "列候选 → 对齐证据 → 比较解释标准 → 暴露代价与未知 → 给出相对结论",
      "agent_use": "让 Agent 明确“更好”是比较判断，不是事实保证。",
      "applicability": {
        "when": [
          "存在多个能解释同一证据的候选模型。"
        ],
        "not_when": [
          "只有一个候选且没有比较标准。"
        ]
      },
      "source_refs": [
        "ref:sep-scientific-realism",
        "ref:sep-abduction"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有观测证据、至少两个候选解释和比较标准。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "列出候选解释、预测和辅助假设"
          },
          {
            "order": 2,
            "instruction": "按覆盖、一致性、简单性、统一性和预测力比较"
          },
          {
            "order": 3,
            "instruction": "检查每个候选的反例、代价和未解释残差"
          },
          {
            "order": 4,
            "instruction": "输出相对排序、敏感标准和不可判定部分"
          }
        ],
        "stop_conditions": [
          "候选或比较标准缺失，或证据不足以区分候选。"
        ],
        "success_conditions": [
          "排序理由、替代解释和结论范围可复核。"
        ],
        "evidence_required": [
          "候选表、证据映射、比较标准、反例和不确定性。"
        ],
        "failure_modes": [
          "把最简单解释当作真理。",
          "遗漏严重替代解释。"
        ]
      }
    },
    {
      "id": "psoa.philosophy-science-epistemology.auxiliary-assumption-audit",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "source_key": "philosophy-science-epistemology.auxiliary-assumption-audit",
      "name": "Auxiliary Assumption Audit",
      "name_zh": "辅助假设审计",
      "domain": "philosophy-science-epistemology",
      "status": "experimental",
      "summary": "检查预测失败到底归因于核心假设、测量、仪器、背景理论还是推导链中的辅助条件。",
      "core_question": "结果不符时，究竟是哪一个假设或桥接条件出了问题？",
      "operation": "列出预测链 → 标记辅助假设 → 分层替换/敏感性检查 → 限定归因",
      "agent_use": "阻止 Agent 用一次失败直接否定整个理论，或反过来逃避核心错误。",
      "applicability": {
        "when": [
          "测试结果依赖多个背景条件、测量模型或桥接假设。"
        ],
        "not_when": [
          "核心假设与观测之间没有中间假设。"
        ]
      },
      "source_refs": [
        "ref:sep-science-theory-observation",
        "ref:sep-scientific-underdetermination"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "已有理论、预测、观测和推导链。"
        ],
        "inputs": [
          "theory",
          "prediction",
          "observation",
          "auxiliary_assumptions"
        ],
        "procedure": [
          "展开从理论到观测的全部桥接条件",
          "将失败定位到候选假设层",
          "逐一替换或敏感性分析",
          "只对被证据触及的层做归因"
        ],
        "effect": {
          "state": "assumption_attribution_bounded",
          "statement": "形成带辅助假设分层的失败归因和待测条件。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "预测推导图、辅助假设、测量条件、替换结果和归因范围。"
        ],
        "failure_modes": [
          "把工具误差当理论证伪。",
          "以不可检验辅助假设无限护航理论。"
        ],
        "recovery": [
          "增加区分性实验或公开理论暂不可判定。"
        ]
      }
    },
    {
      "id": "psoa.philosophy-science-epistemology.underdetermination-branching",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "source_key": "philosophy-science-epistemology.underdetermination-branching",
      "name": "Underdetermination Branching",
      "name_zh": "欠定性分支",
      "domain": "philosophy-science-epistemology",
      "status": "experimental",
      "summary": "当同一证据支持多个理论时显式保留分支，并区分证据不足造成的欠定与原则上欠定。",
      "core_question": "现有证据还允许哪些认真对待的替代理论？",
      "operation": "枚举候选 → 检查共同预测 → 标出区分点 → 记录证据不足/原则欠定强度",
      "agent_use": "让 Agent 在证据不足时保留合理分支，不强行单一路线。",
      "applicability": {
        "when": [
          "多个候选理论对当前证据同样相容。"
        ],
        "not_when": [
          "已有强区分证据且替代方案不再合理。"
        ]
      },
      "source_refs": [
        "ref:sep-scientific-underdetermination",
        "ref:sep-scientific-realism"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有证据集合和至少两个非空候选解释。"
        ],
        "procedure": [
          "构造候选理论与共同预测表",
          "寻找差异预测、辅助假设和新测量条件",
          "标注候选的经验等价与解释代价",
          "保持分支并给出下一项区分证据"
        ],
        "effect": {
          "state": "theory_alternatives_explicit",
          "statement": "形成替代理论、共同预测、差异预测和欠定性强度记录。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "候选理论、共同/差异预测、辅助假设和区分证据设计。"
        ],
        "failure_modes": [
          "把逻辑可能性当作同等可信。",
          "把证据不足造成的欠定误写成原则欠定。"
        ],
        "recovery": [
          "按可行性、解释力和新证据价值收缩候选。"
        ],
        "inputs": [
          "artifact",
          "constraints",
          "evidence"
        ]
      }
    },
    {
      "id": "psoa.philosophy-science-epistemology.discriminating-evidence-design",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "source_key": "philosophy-science-epistemology.discriminating-evidence-design",
      "name": "Discriminating Evidence Design",
      "name_zh": "区分性证据设计",
      "domain": "philosophy-science-epistemology",
      "status": "experimental",
      "summary": "优先设计能让竞争解释产生不同预期的观察、实验或资料，而不是继续收集同质支持。",
      "core_question": "下一条证据怎样最大化区分候选解释？",
      "operation": "比较候选预测 → 找分歧变量 → 评估可观测性/成本 → 设计最小区分证据",
      "agent_use": "把“再找更多资料”变成有信息增益的调查计划。",
      "applicability": {
        "when": [
          "候选解释在某些条件下有不同可观测后果。"
        ],
        "not_when": [
          "候选在可及条件下完全经验等价。"
        ]
      },
      "source_refs": [
        "ref:sep-scientific-method",
        "ref:national-academies-hypothesis-testing"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "候选解释、可观测变量和预算边界已列出。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "列每个候选在候选条件下的预期结果"
          },
          {
            "order": 2,
            "instruction": "找出结果差异最大且可测的变量"
          },
          {
            "order": 3,
            "instruction": "审查混杂、测量误差和伦理/资源约束"
          },
          {
            "order": 4,
            "instruction": "选择最小区分方案并预先声明判定规则"
          }
        ],
        "stop_conditions": [
          "没有可实现的区分预测或风险超过允许边界。"
        ],
        "success_conditions": [
          "证据设计能改变候选排序，并有预先声明的解释规则。"
        ],
        "evidence_required": [
          "候选预测矩阵、区分变量、测量方案、混杂和判定规则。"
        ],
        "failure_modes": [
          "设计只会重复支持已有信念的证据。",
          "事后修改判定规则。"
        ]
      }
    },
    {
      "id": "psoa.philosophy-science-epistemology.epistemic-inquiry-loop",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "derived",
      "name": "Epistemic Inquiry Loop",
      "name_zh": "认识论探究循环",
      "domain": "philosophy-science-epistemology",
      "status": "experimental",
      "summary": "组合观察分离、最佳解释、辅助假设审计、欠定分支和区分性证据设计，形成克制的科学推理循环。",
      "core_question": "当前解释为什么相对更好，什么证据会让它失效？",
      "operation": "Observe → Explain → Audit Assumptions → Branch Alternatives → Discriminate",
      "agent_use": "把不确定性和替代解释纳入 Agent 的默认推理流程。",
      "applicability": {
        "when": [
          "需要从不完整证据形成可修正解释。"
        ],
        "not_when": [
          "问题已有形式证明或完全确定的机械规则。"
        ]
      },
      "source_refs": [
        "ref:sep-scientific-method",
        "ref:sep-scientific-underdetermination",
        "ref:national-academies-reproducibility"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "存在观测材料、候选解释和可获得的新证据路径。"
        ],
        "steps": [
          {
            "order": 1,
            "apply_model": "psoa.philosophy-science-epistemology.observation-interpretation-separation"
          },
          {
            "order": 2,
            "use": "psoa.philosophy-science-epistemology.inference-to-best-explanation"
          },
          {
            "order": 3,
            "use": "psoa.philosophy-science-epistemology.auxiliary-assumption-audit"
          },
          {
            "order": 4,
            "use": "psoa.philosophy-science-epistemology.underdetermination-branching"
          },
          {
            "order": 5,
            "use": "psoa.philosophy-science-epistemology.discriminating-evidence-design"
          }
        ],
        "stop_conditions": [
          "分支无法区分、证据不可得、风险超界或结论已达到预设范围。"
        ],
        "success_conditions": [
          "事实、解释、辅助假设、替代分支和下一步证据均被记录。"
        ],
        "evidence_required": [
          "观测/解释表、候选比较、假设审计、分支和区分证据。"
        ],
        "failure_modes": [
          "最佳解释被误写成确定事实。"
        ]
      }
    }
  ]
}
