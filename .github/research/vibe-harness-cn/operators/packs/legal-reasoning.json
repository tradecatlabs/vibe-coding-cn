{
  "api_version": "vibe-harness-cn.dev/v1alpha1",
  "kind": "OperatorPack",
  "metadata": {
    "id": "psoa.pack.legal-reasoning",
    "version": "1.0.0",
    "domain": "legal-reasoning",
    "title": "法律推理",
    "summary": "从争点、权威、先例、证明标准和规则—事实适用中提取可审查法律研究程序。",
    "source_entry_count": 5,
    "derived_entry_count": 1
  },
  "entries": [
    {
      "id": "psoa.legal-reasoning.issue-spotting",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "source_key": "legal-reasoning.issue-spotting",
      "name": "Issue Spotting",
      "name_zh": "争点识别",
      "domain": "legal-reasoning",
      "status": "experimental",
      "summary": "把叙述事实拆成待回答的法律争点、事实要件、主张/抗辩和法域问题。",
      "core_question": "当前争议到底是哪些可裁判的法律问题，哪些只是背景？",
      "operation": "抽取事实与请求 → 标记法域和程序位置 → 按要件形成争点树 → 列待证事实与反方主张",
      "agent_use": "让 Agent 先明确问题边界，避免直接给结论或把事实描述当法律规则。",
      "applicability": {
        "when": [
          "存在需要法律分析的事实叙述、规则问题或主张。"
        ],
        "not_when": [
          "只需一般信息整理且不涉及适用法律或权利义务判断。"
        ]
      },
      "source_refs": [
        "ref:uscourts-judicial-process-analogy",
        "ref:us-doj-law-fact-application"
      ],
      "governance": {
        "risk_level": "high",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "事实、请求或争议至少能形成初稿。"
        ],
        "inputs": [
          "facts",
          "claims",
          "defenses",
          "jurisdiction",
          "procedure_stage"
        ],
        "procedure": [
          "区分事实、争点、请求和背景",
          "标记可能决定结果的要件事实及缺失事实",
          "列出适用法域、程序阶段和候选权威来源",
          "为每个争点写支持与反对的最小问题"
        ],
        "effect": {
          "state": "legal_issues_spotted",
          "statement": "形成按法域、要件和争议点组织的法律问题树。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "争点树、关键事实清单、法域/程序假设和缺失信息。"
        ],
        "failure_modes": [
          "把价值判断或常识直接当成法律规则。",
          "遗漏反方抗辩、管辖或程序门槛。"
        ],
        "recovery": [
          "向有资质法律人员确认法域和程序；不能确认时只输出研究问题，不给个案结论。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "representation",
          "secondary_classes": [
            "decomposition",
            "verification-falsification"
          ]
        }
      }
    },
    {
      "id": "psoa.legal-reasoning.authority-hierarchy",
      "version": "1.0.0",
      "kind": "MentalModelSpec",
      "origin": "source",
      "source_key": "legal-reasoning.authority-hierarchy",
      "name": "Authority Hierarchy",
      "name_zh": "权威层级",
      "domain": "legal-reasoning",
      "status": "experimental",
      "summary": "把法规、判例、行政规则、合同文本和二手解释按适用法域、层级、时效和冲突关系区分。",
      "core_question": "当前结论依赖哪条权威，权威之间是否存在层级、时间或法域冲突？",
      "operation": "列权威来源 → 标注法域/层级/生效状态 → 检查冲突与例外 → 只在适用范围内使用",
      "agent_use": "防止 Agent 把博客、旧判例或其他法域材料当成当前控制规则。",
      "applicability": {
        "when": [
          "需要解释规则来源、优先级或冲突。"
        ],
        "not_when": [
          "纯事实总结且不需要规范性结论。"
        ]
      },
      "source_refs": [
        "ref:uscourts-judicial-process-analogy",
        "ref:us-federal-rules-evidence"
      ],
      "governance": {
        "risk_level": "high",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "questions": [
          "谁发布了这条规则，管辖范围是什么？",
          "它是控制性规则、说服性材料还是二手解释？",
          "生效、废止、例外和冲突关系是什么？"
        ],
        "interpretation_rules": [
          "先记录法域、时间和权威层级，再讨论规则内容。",
          "区分规则文本、判例理由、附带评论和非权威解释。",
          "无法确认控制权威时把结论标为待核验。"
        ],
        "limitations": [
          "不同法域法律不自动可迁移。",
          "本模型不提供法律意见，也不判断具体案件应诉策略。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "representation",
          "secondary_classes": [
            "verification-falsification"
          ]
        }
      }
    },
    {
      "id": "psoa.legal-reasoning.precedent-analogy-distinction",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "source_key": "legal-reasoning.precedent-analogy-distinction",
      "name": "Precedent Analogy and Distinction",
      "name_zh": "判例类比与区分",
      "domain": "legal-reasoning",
      "status": "experimental",
      "summary": "通过比较实质事实、规则理由和结果，判断既有先例是可类比、可区分还是不可用。",
      "core_question": "当前事实与先例的相似/差异是否足以改变规则适用？",
      "operation": "Facts → Materiality → Analogy/Distinction → Consequence",
      "agent_use": "把 Agent 从关键词相似提升到可解释的事实—规则类比。",
      "applicability": {
        "when": [
          "存在已识别的先例、规则和当前事实。"
        ],
        "not_when": [
          "没有可核验先例或法域不明。"
        ]
      },
      "source_refs": [
        "ref:uscourts-judicial-process-analogy",
        "ref:us-doj-law-fact-application"
      ],
      "governance": {
        "risk_level": "high",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "先例全文、当前事实和争议规则可读取。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "提取先例的实质事实、规则、理由和结果"
          },
          {
            "order": 2,
            "instruction": "把当前事实映射到同一事实维度，标记相似与差异"
          },
          {
            "order": 3,
            "instruction": "解释每个差异是否对规则理由具有实质影响"
          },
          {
            "order": 4,
            "instruction": "给出类比、区分或不可判定三种结论，并列反方解释"
          }
        ],
        "stop_conditions": [
          "事实或法域无法核验。",
          "差异的实质性没有证据支持。"
        ],
        "success_conditions": [
          "事实映射、实质性理由和反方解释可逐项追溯。"
        ],
        "evidence_required": [
          "事实映射、实质性理由和反方解释可逐项追溯。"
        ],
        "failure_modes": [
          "把表面关键词相似当作控制性类比。",
          "忽略先例理由而只摘录结论。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "transformation",
          "secondary_classes": [
            "verification-falsification"
          ]
        }
      }
    },
    {
      "id": "psoa.legal-reasoning.burden-standard-of-proof",
      "version": "1.0.0",
      "kind": "MentalModelSpec",
      "origin": "source",
      "source_key": "legal-reasoning.burden-standard-of-proof",
      "name": "Burden and Standard of Proof",
      "name_zh": "举证责任与证明标准",
      "domain": "legal-reasoning",
      "status": "experimental",
      "summary": "区分谁负担提出证据、谁负担说服裁判者，以及不同程序和法域下所需证明强度。",
      "core_question": "这项主张由谁证明，达到什么标准才足以支持该法律结论？",
      "operation": "标记主张 → 分配举证责任 → 指定证明标准 → 检查证据是否满足用途",
      "agent_use": "让 Agent 不把‘有证据’误写成‘已满足法律证明标准’。",
      "applicability": {
        "when": [
          "需要评价证据是否足以支持法律主张。"
        ],
        "not_when": [
          "只做事实罗列且不作法律证明判断。"
        ]
      },
      "source_refs": [
        "ref:us-fre-401-relevance",
        "ref:us-federal-rules-evidence"
      ],
      "governance": {
        "risk_level": "high",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "questions": [
          "谁承担 burden of production 和 burden of persuasion？",
          "适用何种证明标准，标准来自哪个法域/程序？",
          "证据支持的是可采性、相关性还是最终说服力？"
        ],
        "interpretation_rules": [
          "先分清证据相关性、可采性、重量和最终证明标准。",
          "法律标准必须绑定法域和程序，不用模型置信度替代。",
          "未确认标准时只报告证据缺口和可能标准。"
        ],
        "limitations": [
          "标准高度依赖法域、诉讼类型和程序阶段。",
          "模型不能替代裁判者或律师的证据裁量。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "verification-falsification",
          "secondary_classes": [
            "control-metacognition"
          ]
        }
      }
    },
    {
      "id": "psoa.legal-reasoning.application-and-counterargument-audit",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "source_key": "legal-reasoning.application-and-counterargument-audit",
      "name": "Application and Counterargument Audit",
      "name_zh": "规则事实适用与反方审计",
      "domain": "legal-reasoning",
      "status": "experimental",
      "summary": "将确定的规则逐项应用到事实，同时生成最强反方解释、证据缺口和不确定范围。",
      "core_question": "规则的每个要件由哪些事实满足，最强反方会在哪里攻击？",
      "operation": "Rule elements → Fact mapping → Counterargument → Uncertainty → Scoped conclusion",
      "agent_use": "要求 Agent 给出可审查的规则—事实链，而不是只写 IRAC 标题或结论。",
      "applicability": {
        "when": [
          "争点和候选规则已识别，事实可逐项映射。"
        ],
        "not_when": [
          "法域/规则尚未确认或事实完全缺失。"
        ]
      },
      "source_refs": [
        "ref:us-doj-law-fact-application",
        "ref:us-fre-702-reliability"
      ],
      "governance": {
        "risk_level": "high",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "规则文本和关键事实可引用。"
        ],
        "inputs": [
          "legal_rule",
          "rule_elements",
          "facts",
          "evidence",
          "counterarguments"
        ],
        "procedure": [
          "逐项列规则要件和满足/不满足/未知状态",
          "为每项要件绑定事实或证据来源",
          "构造最强反方解释并检查规则适用边界",
          "把结论限制在已支持的法域、程序和事实范围"
        ],
        "effect": {
          "state": "legal_application_audited",
          "statement": "形成规则—事实—反方—不确定性链条。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "要件映射、证据引用、反方主张、不确定性和范围限定。"
        ],
        "failure_modes": [
          "把推测事实当已证事实。",
          "忽略不利先例或解释分歧。"
        ],
        "recovery": [
          "降级为研究备忘录并请求专业复核；不输出个案确定性建议。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "verification-falsification",
          "secondary_classes": [
            "diagnosis-revision"
          ]
        }
      }
    },
    {
      "id": "psoa.legal-reasoning.legal-reasoning-loop",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "derived",
      "name": "Legal Reasoning Loop",
      "name_zh": "法律推理循环",
      "domain": "legal-reasoning",
      "status": "experimental",
      "summary": "组合争点识别、权威分层、先例比较、证明标准和规则—事实审计，形成法域敏感的研究流程。",
      "core_question": "在给出法律结论前，问题、权威、类比、证据和反方是否都可追溯？",
      "operation": "Issue → Authority → Analogy → Proof → Application",
      "agent_use": "作为 Harness 的法律资料研究方法；不自动提供法律意见或触发法律行动。",
      "applicability": {
        "when": [
          "任务是法律研究、政策分析或合同审阅草稿。"
        ],
        "not_when": [
          "需要代表当事人作最终法律决定、提交文件或执行权利义务。"
        ]
      },
      "source_refs": [
        "ref:uscourts-judicial-process-analogy",
        "ref:us-fre-401-relevance"
      ],
      "governance": {
        "risk_level": "high",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "法域、问题范围和资料边界已声明"
        ],
        "steps": [
          {
            "order": 1,
            "use": "psoa.legal-reasoning.issue-spotting"
          },
          {
            "order": 2,
            "apply_model": "psoa.legal-reasoning.authority-hierarchy"
          },
          {
            "order": 3,
            "use": "psoa.legal-reasoning.precedent-analogy-distinction"
          },
          {
            "order": 4,
            "apply_model": "psoa.legal-reasoning.burden-standard-of-proof"
          },
          {
            "order": 5,
            "use": "psoa.legal-reasoning.application-and-counterargument-audit"
          }
        ],
        "stop_conditions": [
          "法域、权威或关键事实无法核验。",
          "涉及现实法律行动且没有专业人员接管。"
        ],
        "success_conditions": [
          "形成争点树、权威账本、类比表、证明标准和受限结论。"
        ],
        "evidence_required": [
          "争点树、权威账本、类比表、证明标准和受限结论。"
        ],
        "failure_modes": [
          "把参考流程当法律意见。",
          "用单一先例或模型置信度掩盖解释分歧。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "control-metacognition",
          "secondary_classes": [
            "verification-falsification"
          ]
        }
      }
    }
  ],
  "extensions": {
    "vibe-harness-cn": {
      "reference_frameworks": [
        "ref:uscourts-judicial-process-analogy",
        "ref:us-fre-401-relevance",
        "ref:us-fre-702-reliability",
        "ref:us-doj-law-fact-application",
        "ref:us-federal-rules-evidence"
      ]
    }
  }
}
