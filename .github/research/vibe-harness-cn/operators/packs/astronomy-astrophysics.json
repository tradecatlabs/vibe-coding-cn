{
  "api_version": "vibe-harness-cn.dev/v1alpha1",
  "kind": "OperatorPack",
  "metadata": {
    "id": "psoa.pack.astronomy-astrophysics",
    "version": "1.0.0",
    "domain": "astronomy-astrophysics",
    "title": "天文学与天体物理",
    "summary": "把观测模型、背景扣除、信号检测、参数拟合、校准和独立确认转为观测推理程序。",
    "source_entry_count": 5,
    "derived_entry_count": 1
  },
  "entries": [
    {
      "id": "psoa.astronomy-astrophysics.observation-model-separation",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "source_key": "astronomy-astrophysics.observation-model-separation",
      "name": "Observation Model Separation",
      "name_zh": "观测与模型分离",
      "domain": "astronomy-astrophysics",
      "status": "experimental",
      "summary": "把探测器观测、仪器/背景模型、天体源模型和待估参数分层。",
      "core_question": "数据中的差异来自源、仪器、背景还是模型假设？",
      "operation": "记录原始观测 → 分离源/背景/仪器项 → 声明 nuisance 参数 → 建前向模型",
      "agent_use": "阻止 Agent 把处理后的图像或拟合输出当原始事实。",
      "applicability": {
        "when": [
          "天文结论依赖观测数据与仪器/背景模型。"
        ],
        "not_when": [
          "只有已校准的确定性目录值且无需回溯。"
        ]
      },
      "source_refs": [
        "ref:esa-gaia-calibration-models",
        "ref:heasarc-xspec-statistics"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有观测、仪器配置、背景信息和候选源模型。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "保存观测、时间、仪器和校准版本"
          },
          {
            "order": 2,
            "instruction": "区分源信号、背景、读出噪声和 nuisance 参数"
          },
          {
            "order": 3,
            "instruction": "写出观测到预测的前向模型"
          },
          {
            "order": 4,
            "instruction": "检查哪些结论依赖模型而非直接观测"
          }
        ],
        "stop_conditions": [
          "校准/背景模型缺失且无法评估其影响。"
        ],
        "success_conditions": [
          "观测、模型、参数和误差来源可分别追溯。"
        ],
        "evidence_required": [
          "原始观测摘要、校准、背景、模型、参数和版本。"
        ],
        "failure_modes": [
          "把处理产物当无模型事实。",
          "遗漏 nuisance 参数。"
        ]
      }
    },
    {
      "id": "psoa.astronomy-astrophysics.signal-background-discrimination",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "source_key": "astronomy-astrophysics.signal-background-discrimination",
      "name": "Signal Background Discrimination",
      "name_zh": "信号与背景区分",
      "domain": "astronomy-astrophysics",
      "status": "experimental",
      "summary": "根据噪声分布、背景模型和检测阈值判断是否存在源信号，并把检测与参数观测分开。",
      "core_question": "看到超出背景的模式，足以称为检测还是只能称为候选？",
      "operation": "估计背景 → 选择噪声模型 → 计算信噪/显著性 → 检查系统误差 → 分离检测与测量",
      "agent_use": "避免 Agent 把弱候选、阈值越过和精确参数估计混为一谈。",
      "applicability": {
        "when": [
          "需要从含噪天文数据判断源是否存在。"
        ],
        "not_when": [
          "数据已由独立流程确认且不再做检测判断。"
        ]
      },
      "source_refs": [
        "ref:nasa-detection-observation",
        "ref:heasarc-source-detection",
        "ref:heasarc-background-subtraction"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有数据、背景估计、噪声分布和检测规则。"
        ],
        "inputs": [
          "data",
          "background",
          "noise_model",
          "threshold",
          "systematics"
        ],
        "procedure": [
          "选择与计数/读出过程匹配的噪声模型",
          "估计并记录背景及其不确定度",
          "计算检测统计量和阈值越过概率",
          "检查系统误差、重复试验和多重比较",
          "分别报告 detection 与参数 observation"
        ],
        "effect": {
          "state": "signal_status_assessed",
          "statement": "形成带背景、噪声、阈值和系统误差的检测判断。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "背景方法、噪声模型、统计量、阈值、系统误差和原始计数。"
        ],
        "failure_modes": [
          "把显著性当源参数准确。",
          "背景模型失配造成伪信号。"
        ],
        "recovery": [
          "更换背景区、做多方法比较或标记候选未确认。"
        ]
      }
    },
    {
      "id": "psoa.astronomy-astrophysics.dimensional-scale-check",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "source_key": "astronomy-astrophysics.dimensional-scale-check",
      "name": "Dimensional and Scale Check",
      "name_zh": "量纲与尺度检查",
      "domain": "astronomy-astrophysics",
      "status": "experimental",
      "summary": "检查天体物理公式、单位、距离/时间尺度和数量级是否与观测情境相容。",
      "core_question": "这个结果的单位、数量级和尺度在天文情境中是否可能？",
      "operation": "统一单位 → 做量纲检查 → 估数量级 → 与观测/物理上限比较",
      "agent_use": "用低成本检查筛掉明显不可能的天文推断。",
      "applicability": {
        "when": [
          "公式、参数或观测量具有单位和尺度。"
        ],
        "not_when": [
          "纯分类标签且无物理量。"
        ]
      },
      "source_refs": [
        "ref:mit-dimensional-analysis",
        "ref:mit-approximation"
      ],
      "governance": {
        "risk_level": "low",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "变量、单位、距离/时间尺度和参考范围可列出。"
        ],
        "procedure": [
          "统一 SI/天文单位并标出换算",
          "检查方程左右量纲和无量纲因子",
          "估算数量级与误差上界",
          "与观测值、已知尺度和物理约束比较"
        ],
        "effect": {
          "state": "astrophysical_scale_checked",
          "statement": "形成单位、数量级、尺度和异常点清单。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "not_applicable",
          "failed"
        ],
        "evidence_required": [
          "单位表、量纲推导、数量级估算、参考范围和异常解释。"
        ],
        "failure_modes": [
          "遗漏距离平方、红移或单位换算。",
          "把数量级一致当模型证实。"
        ],
        "recovery": [
          "重新定义尺度、补充物理项或降低结论。"
        ],
        "inputs": [
          "artifact",
          "constraints",
          "evidence"
        ]
      }
    },
    {
      "id": "psoa.astronomy-astrophysics.lightcurve-or-spectrum-model-fit",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "source_key": "astronomy-astrophysics.lightcurve-or-spectrum-model-fit",
      "name": "Light Curve or Spectrum Model Fit",
      "name_zh": "光变曲线/光谱模型拟合",
      "domain": "astronomy-astrophysics",
      "status": "experimental",
      "summary": "选择与数据分布匹配的模型，拟合参数，报告不确定度并做拟合优度与残差审查。",
      "core_question": "模型是否能解释数据，参数区间和残差是否支持当前天体解释？",
      "operation": "选模型/统计 → 拟合参数 → 估区间 → 检查拟合优度/残差 → 比较候选",
      "agent_use": "把“曲线看起来像”变成带统计和模型限制的测量程序。",
      "applicability": {
        "when": [
          "有时间序列、光谱或其他可与前向模型配对的观测。"
        ],
        "not_when": [
          "数据质量或模型空间不足以支持参数解释。"
        ]
      },
      "source_refs": [
        "ref:heasarc-xspec-statistics",
        "ref:heasarc-spectral-fitting",
        "ref:esa-gaia-calibration-models"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "观测、模型、噪声分布、参数和校准已固定。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "依据数据生成机制选择 Gaussian/Poisson 等统计模型"
          },
          {
            "order": 2,
            "instruction": "拟合源参数和必要的背景/nuisance 参数"
          },
          {
            "order": 3,
            "instruction": "计算置信区间或后验分布并记录相关性"
          },
          {
            "order": 4,
            "instruction": "检查拟合优度、残差结构和候选模型比较"
          }
        ],
        "stop_conditions": [
          "模型拟合失败、残差有未解释结构或校准误差主导。"
        ],
        "success_conditions": [
          "参数、区间、拟合优度、残差和模型适用范围可复核。"
        ],
        "evidence_required": [
          "数据/校准版本、统计模型、拟合参数、区间、残差和优度结果。"
        ],
        "failure_modes": [
          "拟合通过被误读为模型唯一正确。",
          "误差分布与统计量不匹配。"
        ]
      }
    },
    {
      "id": "psoa.astronomy-astrophysics.independent-observation-confirmation",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "source_key": "astronomy-astrophysics.independent-observation-confirmation",
      "name": "Independent Observation Confirmation",
      "name_zh": "独立观测确认",
      "domain": "astronomy-astrophysics",
      "status": "experimental",
      "summary": "用不同仪器、波段、时间段或分析管线复核候选信号和参数，检查结果是否依赖单一观测路径。",
      "core_question": "换一个独立观测或处理路径，核心结论还成立吗？",
      "operation": "锁定原结论 → 选择独立观测 → 同步预设分析 → 比较一致性与系统差异",
      "agent_use": "为高影响天文结论增加跨观测的复现与异质证据。",
      "applicability": {
        "when": [
          "有不同仪器、波段、时间或可独立重分析的数据。"
        ],
        "not_when": [
          "客观上只有单次观测且只能声明未确认。"
        ]
      },
      "source_refs": [
        "ref:national-academies-reproducibility",
        "ref:heasarc-nicer-analysis-caveats"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "原始结论、独立数据源和比较指标已定义。"
        ],
        "procedure": [
          "冻结原结论、分析规则和阈值",
          "选择观测条件/仪器/波段不同的复核数据",
          "在不看原结果细节的情况下重做关键分析",
          "比较检测、参数和系统误差的一致性"
        ],
        "effect": {
          "state": "astronomical_claim_cross_checked",
          "statement": "形成跨观测一致性、差异来源和未确认部分。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "观测来源差异、预设规则、独立结果、差异分析和校准版本。"
        ],
        "failure_modes": [
          "复核数据与原数据共享同一系统误差。",
          "看到原结果后调参造成确认偏差。"
        ],
        "recovery": [
          "寻找真正独立数据或降级为单观测候选。"
        ],
        "inputs": [
          "artifact",
          "constraints",
          "evidence"
        ]
      }
    },
    {
      "id": "psoa.astronomy-astrophysics.astrophysical-inference-loop",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "derived",
      "name": "Astrophysical Inference Loop",
      "name_zh": "天体物理推理循环",
      "domain": "astronomy-astrophysics",
      "status": "experimental",
      "summary": "组合观测建模、信号区分、尺度检查、统计拟合和独立确认，形成从数据到受限天体解释的循环。",
      "core_question": "候选天体解释是否经得起仪器、背景、尺度、拟合和独立观测检查？",
      "operation": "Model Observation → Discriminate Signal → Check Scale → Fit → Confirm Independently",
      "agent_use": "让 Agent 把检测、测量和解释分层，并保留系统误差。",
      "applicability": {
        "when": [
          "需要从天文观测形成参数或天体物理解释。"
        ],
        "not_when": [
          "没有观测或模型输入。"
        ]
      },
      "source_refs": [
        "ref:esa-gaia-calibration-models",
        "ref:heasarc-xspec-statistics",
        "ref:national-academies-reproducibility"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有观测数据、校准和可比较的候选模型。"
        ],
        "steps": [
          {
            "order": 1,
            "use": "psoa.astronomy-astrophysics.observation-model-separation"
          },
          {
            "order": 2,
            "use": "psoa.astronomy-astrophysics.signal-background-discrimination"
          },
          {
            "order": 3,
            "use": "psoa.astronomy-astrophysics.dimensional-scale-check"
          },
          {
            "order": 4,
            "use": "psoa.astronomy-astrophysics.lightcurve-or-spectrum-model-fit"
          },
          {
            "order": 5,
            "use": "psoa.astronomy-astrophysics.independent-observation-confirmation"
          }
        ],
        "stop_conditions": [
          "背景/校准不明、模型拟合不合格、尺度矛盾或独立确认失败。"
        ],
        "success_conditions": [
          "检测与测量分开，模型、区间、残差和独立观测均有证据。"
        ],
        "evidence_required": [
          "观测/模型分层、检测统计、尺度检查、拟合和独立复核。"
        ],
        "failure_modes": [
          "单一拟合或阈值越过被误写成天体事实。"
        ]
      }
    }
  ]
}
