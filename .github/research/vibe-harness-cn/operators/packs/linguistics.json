{
  "api_version": "vibe-harness-cn.dev/v1alpha1",
  "kind": "OperatorPack",
  "metadata": {
    "id": "psoa.pack.linguistics",
    "version": "1.0.0",
    "domain": "linguistics",
    "title": "语言学",
    "summary": "把语料代表性、最小对比、句法—语义—语用分层、篇章上下文和歧义消解转成可复查语言分析程序。",
    "source_entry_count": 5,
    "derived_entry_count": 1
  },
  "entries": [
    {
      "id": "psoa.linguistics.corpus-evidence-sampling",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "name": "Corpus Evidence Sampling",
      "name_zh": "语料证据采样",
      "domain": "linguistics",
      "status": "experimental",
      "summary": "按语言变体、语域、时间和采样框取得带上下文、标注和缺口说明的语言证据。",
      "core_question": "这些例子能代表我们要描述的语言现象和使用群体吗？",
      "operation": "定义采样框 → 检查来源/平衡 → 保留上下文 → 记录标注与缺口",
      "agent_use": "阻止 Agent 从少量方便例句推导普遍语言规律。",
      "applicability": {
        "when": [
          "需要从语言数据归纳语法、语义或话语规律。"
        ],
        "not_when": [
          "只有单个例句且不需要判断是否具有代表性。"
        ]
      },
      "source_refs": [
        "ref:tei-language-corpora",
        "ref:ud-guidelines"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有明确语言现象、群体/语域和采样目的。"
        ],
        "inputs": [
          "language_variety",
          "corpus",
          "sampling_frame",
          "annotation_plan"
        ],
        "procedure": [
          "定义语言群体、语域、时间和采样框",
          "检查样本来源、平衡性、缺失和重复",
          "记录语料原始上下文、预处理和标注层",
          "把观察结论限定在样本和语言变体范围内"
        ],
        "effect": {
          "state": "linguistic_evidence_sampled",
          "statement": "形成带代表性、上下文和标注说明的语言证据集。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "采样框、样本来源、上下文、标注规范、覆盖与缺口报告。"
        ],
        "failure_modes": [
          "把方便样本当作整个语言。",
          "删除上下文导致句法/语用解释失真。"
        ],
        "recovery": [
          "补充多语域样本，公开排除规则和标注不确定性。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "representation",
          "secondary_classes": [
            "verification-falsification"
          ]
        }
      },
      "source_key": "linguistics.corpus-evidence-sampling"
    },
    {
      "id": "psoa.linguistics.minimal-contrast-test",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "name": "Minimal Contrast Test",
      "name_zh": "最小对比测试",
      "domain": "linguistics",
      "status": "experimental",
      "summary": "只改变一个目标结构或特征，用正例、负例和边界例区分竞争语言假设。",
      "core_question": "如果只改变这个语言特征，判断或解释是否仍然改变？",
      "operation": "控制词汇/语境 → 构造对比 → 记录判断 → 搜索反例和方言边界",
      "agent_use": "让 Agent 把“看起来不同”变成隔离变量的可检验对比。",
      "applicability": {
        "when": [
          "需要判断某语言假设是否区分两个近似现象。"
        ],
        "not_when": [
          "对比句在词汇、语境或多个结构上同时变化，无法隔离变量。"
        ]
      },
      "source_refs": [
        "ref:acl-blimp",
        "ref:ud-conllu-format"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "已有候选语法/语义假设和目标现象。"
        ],
        "inputs": [
          "hypothesis",
          "minimal_pair",
          "controlled_context",
          "human_judgment"
        ],
        "procedure": [
          "只改变一个目标结构或特征，保持词汇和语境尽量一致",
          "构造正例、负例和边界例",
          "记录可接受度、解释或任务表现及评判条件",
          "寻找反例并检查现象是否只属于特定方言/语域"
        ],
        "effect": {
          "state": "linguistic_contrast_tested",
          "statement": "得到隔离目标差异的最小对比证据与边界。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "成对刺激、控制变量、判定标准、评判者一致性和反例。"
        ],
        "failure_modes": [
          "最小对比不最小，混入词汇频率或语境差异。",
          "把模型分数当成人类语言判断。"
        ],
        "recovery": [
          "重写刺激、增加人类基线和多语域复测。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "verification-falsification",
          "secondary_classes": [
            "representation",
            "diagnosis-revision"
          ]
        }
      },
      "source_key": "linguistics.minimal-contrast-test"
    },
    {
      "id": "psoa.linguistics.syntax-semantics-pragmatics-separation",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "name": "Syntax Semantics Pragmatics Separation",
      "name_zh": "句法语义语用分离",
      "domain": "linguistics",
      "status": "experimental",
      "summary": "先分开形式结构、组合意义和上下文推断，再检查跨层依赖。",
      "core_question": "当前结论来自形式约束、组合意义，还是说话者与语境推断？",
      "operation": "Syntax → Semantics → Pragmatics → Prediction",
      "agent_use": "减少把语用偏好误写成语法规则的错误。",
      "applicability": {
        "when": [
          "一个语言现象同时涉及形式、意义、说话者意图或上下文。"
        ],
        "not_when": [
          "现象只需单一层次描述且不存在歧义。"
        ]
      },
      "source_refs": [
        "ref:ud-guidelines",
        "ref:acl-discourse-analysis"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "已收集带上下文的语言例证和候选解释。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "分别描述词法/句法形式、组合语义和话语语境，不把层次混为一谈"
          },
          {
            "order": 2,
            "instruction": "检查同一形式在不同语境中的意义、指称、会话含义或可接受度变化"
          },
          {
            "order": 3,
            "use": "psoa.linguistics.minimal-contrast-test"
          },
          {
            "order": 4,
            "instruction": "将解释限定为数据支持的层次，并记录未决歧义与跨层依赖"
          }
        ],
        "stop_conditions": [
          "缺少上下文或目标层次无法区分。",
          "不同解释在当前数据上不可判别。"
        ],
        "success_conditions": [
          "形式、语义、语用证据及其依赖关系分开记录，且有可检验预测。"
        ],
        "evidence_required": [
          "带上下文例句、形式标注、语义/语用解释、最小对比和待验证预测。"
        ],
        "failure_modes": [
          "把语用推断当句法规则。",
          "只看孤立句子而忽略语境。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "representation",
          "secondary_classes": [
            "verification-falsification",
            "diagnosis-revision"
          ]
        }
      },
      "source_key": "linguistics.syntax-semantics-pragmatics-separation"
    },
    {
      "id": "psoa.linguistics.discourse-context-analysis",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "name": "Discourse and Context Analysis",
      "name_zh": "篇章与语境分析",
      "domain": "linguistics",
      "status": "experimental",
      "summary": "在完整对话/篇章中分析指称、共指、话轮、篇章关系、礼貌和信息结构。",
      "core_question": "同一表达在不同说话者、篇章和任务语境中为何有不同解释？",
      "operation": "Context → Annotate → Compare → Predict",
      "agent_use": "让 Agent 在语境证据上解释语言，而不是凭孤立句直觉。",
      "applicability": {
        "when": [
          "需要解释语言表达在对话、篇章、社会语境中的含义。"
        ],
        "not_when": [
          "问题只关心脱离语境的形式合法性。"
        ]
      },
      "source_refs": [
        "ref:acl-discourse-analysis",
        "ref:tei-language-corpora"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有对话/篇章片段、说话者角色和语境变量。"
        ],
        "steps": [
          {
            "order": 1,
            "use": "psoa.linguistics.corpus-evidence-sampling"
          },
          {
            "order": 2,
            "instruction": "标出指称、话轮、共指、篇章关系、礼貌和信息结构线索"
          },
          {
            "order": 3,
            "instruction": "比较不同语境下同一形式的解释和互动后果"
          },
          {
            "order": 4,
            "instruction": "提出可被替代语境或最小对比检验的预测"
          }
        ],
        "stop_conditions": [
          "上下文不完整或说话者意图只能臆测。",
          "解释无法产生可区分的预测。"
        ],
        "success_conditions": [
          "语境变量、篇章关系、解释和替代预测可追踪。"
        ],
        "evidence_required": [
          "完整片段、语境说明、标注、解释比较和可检验预测。"
        ],
        "failure_modes": [
          "把单个例句的直觉推广到所有话语。",
          "忽略文化、语域或身份变量。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "representation",
          "secondary_classes": [
            "verification-falsification"
          ]
        }
      },
      "source_key": "linguistics.discourse-context-analysis"
    },
    {
      "id": "psoa.linguistics.ambiguity-resolution",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "name": "Linguistic Ambiguity Resolution",
      "name_zh": "语言歧义消解",
      "domain": "linguistics",
      "status": "experimental",
      "summary": "列出句法、词义、指称和语用候选解释，用上下文与区分测试筛选并保留残余歧义。",
      "core_question": "哪些解释仍然可能，当前上下文能排除哪些，下一问最有信息量是什么？",
      "operation": "列候选 → 找消歧线索 → 构造区分测试 → 保留不确定性",
      "agent_use": "让 Agent 在无法消歧时给出多解释和澄清问题，而非编造确定答案。",
      "applicability": {
        "when": [
          "语言输入存在结构、词义、指称或语用歧义。"
        ],
        "not_when": [
          "所有候选解释在上下文和任务中等价，且无需行动决策。"
        ]
      },
      "source_refs": [
        "ref:acl-discourse-analysis",
        "ref:ud-conllu-format"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "已有歧义表达、上下文和至少两个候选解释。"
        ],
        "inputs": [
          "ambiguous_expression",
          "context",
          "candidate_parses",
          "task_goal"
        ],
        "procedure": [
          "列出不同层次的候选解析/解释",
          "用上下文、共现、形式约束和对话目标逐项筛选",
          "构造能区分候选的改写或最小对比",
          "保留无法消解的歧义，避免输出单一确定结论"
        ],
        "effect": {
          "state": "linguistic_ambiguity_profiled",
          "statement": "形成候选解释、消歧证据、残余歧义和下一步询问。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "候选解析、上下文证据、消歧测试、残余歧义和置信度。"
        ],
        "failure_modes": [
          "用常见解释替代语境证据。",
          "把模型偏好误当语言事实。"
        ],
        "recovery": [
          "请求补充上下文或输出多解释与区分问题。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "diagnosis-revision",
          "secondary_classes": [
            "representation",
            "verification-falsification"
          ]
        }
      },
      "source_key": "linguistics.ambiguity-resolution"
    },
    {
      "id": "psoa.linguistics.linguistic-analysis-loop",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "derived",
      "name": "Linguistic Analysis Loop",
      "name_zh": "语言分析循环",
      "domain": "linguistics",
      "status": "experimental",
      "summary": "组合语料采样、分层、篇章分析、最小对比和歧义消解，形成带上下文的语言证据链。",
      "core_question": "语言结论是否来自代表性数据、分层分析和可区分测试？",
      "operation": "Sample → Separate → Contextualize → Contrast → Resolve",
      "agent_use": "作为 Agent 研究语言现象或评测语言模型的基础方法。",
      "applicability": {
        "when": [
          "需要分析新语言现象、评测语言模型或审查语言学结论。"
        ],
        "not_when": [
          "只需要翻译一个句子且没有研究/评估目标。"
        ]
      },
      "source_refs": [
        "ref:acl-blimp",
        "ref:tei-language-corpora",
        "ref:ud-guidelines"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "现象、语言变体、语料和评估目标已声明。"
        ],
        "steps": [
          {
            "order": 1,
            "use": "psoa.linguistics.corpus-evidence-sampling"
          },
          {
            "order": 2,
            "use": "psoa.linguistics.syntax-semantics-pragmatics-separation"
          },
          {
            "order": 3,
            "use": "psoa.linguistics.discourse-context-analysis"
          },
          {
            "order": 4,
            "use": "psoa.linguistics.minimal-contrast-test"
          },
          {
            "order": 5,
            "use": "psoa.linguistics.ambiguity-resolution"
          }
        ],
        "stop_conditions": [
          "采样不具代表性、上下文缺失或假设无法产生可检验对比。",
          "剩余歧义会改变实际决策且没有人类复核。"
        ],
        "success_conditions": [
          "语言证据、形式/意义/语境层次、对比测试和歧义边界均被记录。"
        ],
        "evidence_required": [
          "语料采样、标注、对比刺激、篇章上下文、消歧结果和歧义边界。"
        ],
        "failure_modes": [
          "把有限语料或模型行为概括成普遍语言规律。",
          "忽略方言、语域和标注协议差异。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "verification-falsification",
          "secondary_classes": [
            "representation",
            "diagnosis-revision"
          ]
        }
      }
    }
  ]
}
