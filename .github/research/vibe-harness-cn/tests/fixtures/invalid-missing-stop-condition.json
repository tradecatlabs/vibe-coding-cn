{
  "api_version": "vibe-harness-cn.dev/v1alpha1",
  "kind": "Harness",
  "metadata": {
    "name": "invalid-no-stop-condition",
    "version": "0.1.0",
    "owner": "test-owner",
    "source": {
      "uri": "repo://invalid-fixture",
      "revision": "sha256:test-fixture"
    }
  },
  "spec": {
    "domain": "验证不完整 harness 会被拒绝",
    "objectives": ["触发停止条件门禁"],
    "exclusions": ["不执行任何真实工具"],
    "autonomy": "L3",
    "risk_level": "high",
    "model": {
      "selection_policy": "fixed",
      "candidates": [{"provider": "test", "model": "test-model"}]
    },
    "instructions": {
      "sources": [
        {
          "id": "test-instruction",
          "level": "task",
          "uri": "fixture://instruction",
          "trust": "trusted_instruction"
        }
      ],
      "external_content_policy": "treat_as_untrusted_data"
    },
    "context": {
      "max_input_tokens": 1000,
      "sources": [{"id": "test-context", "kind": "runtime", "trust": "trusted"}],
      "memory": {"duration": "turn", "retention": "none"},
      "compaction": {"strategy": "none", "preserve": []}
    },
    "tools": [],
    "permissions": {
      "default_action": "deny",
      "approvals": {"model_self_approval": false, "state_location": "runtime_control_plane"},
      "secrets": {"source": "credential_manager", "persist_values": false},
      "network": {"default_action": "deny", "allow": []}
    },
    "loop": {
      "budgets": {
        "max_steps": 1,
        "max_model_calls": 1,
        "max_tool_calls": 0,
        "timeout_ms": 1000,
        "max_total_tokens": 1000
      },
      "retry": {"max_attempts": 0, "backoff": "none"},
      "checkpoint": {"enabled": false, "fields": []}
    },
    "validation": {
      "gates": [
        {"id": "fixture-check", "type": "schema", "required": true, "evidence": "validator 结果"},
        {"id": "fixture-eval", "type": "eval", "required": true, "evidence": "负例专用 eval 声明"}
      ],
      "evidence_binding": [
        "harness_revision",
        "model_identity",
        "policy_version",
        "eval_suite_version",
        "artifact_digest",
        "observed_at"
      ]
    },
    "observability": {
      "tracing": "required",
      "content_capture": "off",
      "redact": ["credentials"]
    },
    "environment": {"sandbox": "required", "filesystem": "none", "network": "none"},
    "lifecycle": {
      "stage": "candidate",
      "promotion_requires": ["负例不应晋升"],
      "rollback": "删除测试运行"
    }
  }
}
