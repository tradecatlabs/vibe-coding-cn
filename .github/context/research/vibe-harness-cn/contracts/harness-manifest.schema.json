{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibe-harness-cn:contracts:harness-manifest:v1alpha1",
  "title": "Harness Manifest",
  "description": "受管 agent harness 的供应商中立治理声明。",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {
      "const": "vibe-harness-cn.dev/v1alpha1"
    },
    "kind": {
      "const": "Harness"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$",
      "maxLength": 128
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "string_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "owner", "source"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "owner": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "revision"],
          "properties": {
            "uri": {
              "$ref": "#/$defs/non_empty_string"
            },
            "revision": {
              "$ref": "#/$defs/non_empty_string"
            }
          }
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "objectives",
        "exclusions",
        "autonomy",
        "risk_level",
        "model",
        "instructions",
        "context",
        "tools",
        "permissions",
        "loop",
        "validation",
        "observability",
        "environment",
        "lifecycle"
      ],
      "properties": {
        "domain": {
          "$ref": "#/$defs/non_empty_string"
        },
        "objectives": {
          "$ref": "#/$defs/string_list"
        },
        "exclusions": {
          "$ref": "#/$defs/string_list"
        },
        "autonomy": {
          "enum": ["L0", "L1", "L2", "L3", "L4", "L5"]
        },
        "risk_level": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "instructions": {
          "$ref": "#/$defs/instructions"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "loop": {
          "$ref": "#/$defs/loop"
        },
        "validation": {
          "$ref": "#/$defs/validation"
        },
        "observability": {
          "$ref": "#/$defs/observability"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_policy", "candidates"],
      "properties": {
        "selection_policy": {
          "enum": ["fixed", "ordered_fallback", "policy_routed"]
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "model"],
            "properties": {
              "provider": {
                "$ref": "#/$defs/identifier"
              },
              "model": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selection_policy": {
                "const": "fixed"
              }
            },
            "required": ["selection_policy"]
          },
          "then": {
            "properties": {
              "candidates": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selection_policy": {
                "const": "ordered_fallback"
              }
            },
            "required": ["selection_policy"]
          },
          "then": {
            "properties": {
              "candidates": {
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "external_content_policy"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "level", "uri", "trust"],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "level": {
                "enum": ["system", "developer", "project", "task"]
              },
              "uri": {
                "$ref": "#/$defs/non_empty_string"
              },
              "trust": {
                "enum": ["trusted_instruction", "untrusted_data"]
              }
            }
          }
        },
        "external_content_policy": {
          "const": "treat_as_untrusted_data"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_input_tokens", "sources", "memory", "compaction"],
      "properties": {
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "trust"],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "kind": {
                "enum": ["repository", "retrieval", "conversation", "runtime", "connector"]
              },
              "trust": {
                "enum": ["trusted", "untrusted"]
              }
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["duration", "retention"],
          "properties": {
            "duration": {
              "enum": ["turn", "session", "workflow", "durable"]
            },
            "retention": {
              "enum": ["none", "session", "policy_managed"]
            }
          }
        },
        "compaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "preserve"],
          "properties": {
            "strategy": {
              "enum": ["none", "summarize_and_reload"]
            },
            "preserve": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "objective",
                  "active_plan",
                  "approval_state",
                  "loaded_instructions",
                  "modified_resources",
                  "pending_actions",
                  "verification_evidence",
                  "budgets"
                ]
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "strategy": {
                    "const": "summarize_and_reload"
                  }
                },
                "required": ["strategy"]
              },
              "then": {
                "properties": {
                  "preserve": {
                    "minItems": 6,
                    "allOf": [
                      {"contains": {"const": "objective"}},
                      {"contains": {"const": "approval_state"}},
                      {"contains": {"const": "loaded_instructions"}},
                      {"contains": {"const": "modified_resources"}},
                      {"contains": {"const": "pending_actions"}},
                      {"contains": {"const": "verification_evidence"}}
                    ]
                  }
                }
              },
              "else": {
                "properties": {
                  "preserve": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose",
        "protocol",
        "contract",
        "risk",
        "access",
        "approval",
        "timeout_ms",
        "retry_policy",
        "idempotency"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "purpose": {
          "$ref": "#/$defs/non_empty_string"
        },
        "protocol": {
          "enum": ["function", "mcp", "shell", "http", "native"]
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_schema", "output_schema", "error_schema", "max_result_bytes"],
          "properties": {
            "input_schema": {
              "type": "object",
              "minProperties": 1
            },
            "output_schema": {
              "type": "object",
              "minProperties": 1
            },
            "error_schema": {
              "type": "object",
              "minProperties": 1
            },
            "max_result_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 104857600
            }
          }
        },
        "risk": {
          "enum": ["read", "local_write", "external_write", "privileged", "destructive"]
        },
        "access": {
          "$ref": "#/$defs/string_list"
        },
        "approval": {
          "enum": ["never", "always"]
        },
        "approval_binding": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["action_arguments", "resource_scope", "actor", "expires_at", "rollback"]
          },
          "allOf": [
            {"contains": {"const": "action_arguments"}},
            {"contains": {"const": "resource_scope"}},
            {"contains": {"const": "expires_at"}}
          ]
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "retry_policy": {
          "enum": ["never", "transient_only", "policy_managed"]
        },
        "idempotency": {
          "enum": ["inherent", "keyed", "guarded", "non_idempotent"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "approval": {
                "const": "always"
              }
            },
            "required": ["approval"]
          },
          "then": {
            "required": ["approval_binding"]
          }
        }
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_action", "approvals", "secrets", "network"],
      "properties": {
        "default_action": {
          "const": "deny"
        },
        "approvals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_self_approval", "state_location"],
          "properties": {
            "model_self_approval": {
              "const": false
            },
            "state_location": {
              "enum": ["runtime_control_plane", "external_approval_system"]
            }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "persist_values"],
          "properties": {
            "source": {
              "const": "credential_manager"
            },
            "persist_values": {
              "const": false
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default_action", "allow"],
          "properties": {
            "default_action": {
              "const": "deny"
            },
            "allow": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budgets", "retry", "checkpoint", "stop_conditions"],
      "properties": {
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_steps", "max_model_calls", "max_tool_calls", "timeout_ms", "max_total_tokens"],
          "properties": {
            "max_steps": {
              "type": "integer",
              "minimum": 1
            },
            "max_model_calls": {
              "type": "integer",
              "minimum": 1
            },
            "max_tool_calls": {
              "type": "integer",
              "minimum": 0
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            "max_total_tokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_attempts", "backoff"],
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "backoff": {
              "enum": ["none", "fixed", "exponential_jitter"]
            }
          }
        },
        "checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "fields"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "fields": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["plan", "approval_state", "modified_resources", "verification_evidence", "budgets"]
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": ["enabled"]
              },
              "then": {
                "properties": {
                  "fields": {
                    "minItems": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "fields": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "description"],
            "properties": {
              "type": {
                "enum": ["success", "budget_exhausted", "human_handoff", "policy_denial", "unrecoverable_error"]
              },
              "description": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          },
          "contains": {
            "type": "object",
            "properties": {
              "type": {
                "const": "success"
              }
            },
            "required": ["type"]
          },
          "minContains": 1
          ,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "budget_exhausted"
                  }
                },
                "required": ["type"]
              },
              "minContains": 1
            }
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gates", "evidence_binding"],
      "properties": {
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "required", "evidence"],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "type": {
                "enum": ["command", "schema", "eval", "inspection", "human_review"]
              },
              "required": {
                "type": "boolean"
              },
              "evidence": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        "evidence_binding": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": ["harness_revision", "model_identity", "policy_version", "eval_suite_version", "artifact_digest", "observed_at"]
          },
          "allOf": [
            {
              "contains": {
                "const": "harness_revision"
              }
            },
            {
              "contains": {
                "const": "model_identity"
              }
            },
            {
              "contains": {
                "const": "artifact_digest"
              }
            },
            {
              "contains": {
                "const": "policy_version"
              }
            },
            {
              "contains": {
                "const": "eval_suite_version"
              }
            },
            {
              "contains": {
                "const": "observed_at"
              }
            }
          ]
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracing", "content_capture", "redact"],
      "properties": {
        "tracing": {
          "enum": ["required", "optional", "disabled"]
        },
        "content_capture": {
          "enum": ["off", "explicit_opt_in"]
        },
        "redact": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["credentials", "tool_arguments", "tool_results", "prompt_content", "personal_data"]
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sandbox", "filesystem", "network"],
      "properties": {
        "sandbox": {
          "enum": ["required", "preferred", "not_applicable"]
        },
        "filesystem": {
          "enum": ["none", "read_only", "workspace_write", "unrestricted"]
        },
        "network": {
          "enum": ["none", "allowlist", "unrestricted"]
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "promotion_requires", "rollback"],
      "properties": {
        "stage": {
          "const": "candidate"
        },
        "promotion_requires": {
          "$ref": "#/$defs/string_list"
        },
        "rollback": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    }
  }
}
