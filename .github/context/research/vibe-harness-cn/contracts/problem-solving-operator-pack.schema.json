{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibe-harness-cn:contracts:problem-solving-operator-pack:v1alpha1",
  "title": "Problem-Solving Operator Pack",
  "description": "Harness 内问题求解算子库的宽松核心交换格式；内容完整度由可选 Profile、评测和运行时策略加严。",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "entries"],
  "properties": {
    "api_version": {"const": "vibe-harness-cn.dev/v1alpha1"},
    "kind": {"const": "OperatorPack"},
    "metadata": {"$ref": "#/$defs/pack_metadata"},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    },
    "extensions": {"$ref": "#/$defs/extension_bag"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$",
      "maxLength": 160
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "vocabulary_token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:[-.][a-z0-9_]+)*$",
      "maxLength": 160
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "string_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/non_empty_string"}
    },
    "domain": {
      "$ref": "#/$defs/identifier"
    },
    "extension_bag": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "additionalProperties": true
    },
    "pack_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "domain"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/semver"},
        "domain": {"$ref": "#/$defs/domain"},
        "title": {"$ref": "#/$defs/non_empty_string"},
        "summary": {"$ref": "#/$defs/non_empty_string"},
        "source_entry_count": {"type": "integer", "minimum": 0},
        "derived_entry_count": {"type": "integer", "minimum": 0},
        "extensions": {"$ref": "#/$defs/extension_bag"}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "when": {"$ref": "#/$defs/string_list"},
        "not_when": {"$ref": "#/$defs/string_list"},
        "extensions": {"$ref": "#/$defs/extension_bag"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "risk_level": {"enum": ["low", "medium", "high"]},
        "permission_decision": {"const": "harness_policy"},
        "outcome_decision": {"const": "verifier"},
        "sensitive_values": {"const": "reference_only"},
        "extensions": {"$ref": "#/$defs/extension_bag"}
      }
    },
    "mental_model_semantics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "questions": {"$ref": "#/$defs/string_list"},
        "interpretation_rules": {"$ref": "#/$defs/string_list"},
        "limitations": {"$ref": "#/$defs/string_list"},
        "extensions": {"$ref": "#/$defs/extension_bag"}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "statement"],
      "properties": {
        "state": {"$ref": "#/$defs/vocabulary_token"},
        "statement": {"$ref": "#/$defs/non_empty_string"},
        "extensions": {"$ref": "#/$defs/extension_bag"}
      }
    },
    "operator_semantics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preconditions": {"$ref": "#/$defs/string_list"},
        "inputs": {"$ref": "#/$defs/string_list"},
        "procedure": {"$ref": "#/$defs/string_list"},
        "effect": {"$ref": "#/$defs/effect"},
        "outcomes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/vocabulary_token"}
        },
        "evidence_required": {"$ref": "#/$defs/string_list"},
        "failure_modes": {"$ref": "#/$defs/string_list"},
        "recovery": {"$ref": "#/$defs/string_list"},
        "extensions": {"$ref": "#/$defs/extension_bag"}
      }
    },
    "method_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "instruction": {"$ref": "#/$defs/non_empty_string"},
        "use": {"$ref": "#/$defs/identifier"},
        "apply_model": {"$ref": "#/$defs/identifier"},
        "extensions": {"$ref": "#/$defs/extension_bag"}
      },
      "oneOf": [
        {"required": ["instruction"], "not": {"anyOf": [{"required": ["use"]}, {"required": ["apply_model"]}]}},
        {"required": ["use"], "not": {"anyOf": [{"required": ["instruction"]}, {"required": ["apply_model"]}]}},
        {"required": ["apply_model"], "not": {"anyOf": [{"required": ["instruction"]}, {"required": ["use"]}]}}
      ]
    },
    "method_semantics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preconditions": {"$ref": "#/$defs/string_list"},
        "steps": {
          "type": "array",
          "items": {"$ref": "#/$defs/method_step"}
        },
        "stop_conditions": {"$ref": "#/$defs/string_list"},
        "success_conditions": {"$ref": "#/$defs/string_list"},
        "evidence_required": {"$ref": "#/$defs/string_list"},
        "failure_modes": {"$ref": "#/$defs/string_list"},
        "extensions": {"$ref": "#/$defs/extension_bag"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "kind",
        "origin",
        "name",
        "domain",
        "status",
        "semantics"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/semver"},
        "kind": {"enum": ["MentalModelSpec", "OperatorSpec", "MethodSpec"]},
        "origin": {"$ref": "#/$defs/vocabulary_token"},
        "source_key": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/non_empty_string"},
        "name_zh": {"$ref": "#/$defs/non_empty_string"},
        "domain": {"$ref": "#/$defs/domain"},
        "status": {"enum": ["draft", "experimental", "verified", "deprecated", "retired"]},
        "summary": {"$ref": "#/$defs/non_empty_string"},
        "core_question": {"$ref": "#/$defs/non_empty_string"},
        "operation": {"$ref": "#/$defs/non_empty_string"},
        "agent_use": {"$ref": "#/$defs/non_empty_string"},
        "applicability": {"$ref": "#/$defs/applicability"},
        "source_refs": {"$ref": "#/$defs/string_list"},
        "governance": {"$ref": "#/$defs/governance"},
        "semantics": {},
        "extensions": {"$ref": "#/$defs/extension_bag"}
      },
      "allOf": [
        {
          "if": {"properties": {"origin": {"const": "source"}}, "required": ["origin"]},
          "then": {"required": ["source_key"]}
        },
        {
          "if": {"properties": {"kind": {"const": "MentalModelSpec"}}, "required": ["kind"]},
          "then": {"properties": {"semantics": {"$ref": "#/$defs/mental_model_semantics"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "OperatorSpec"}}, "required": ["kind"]},
          "then": {"properties": {"semantics": {"$ref": "#/$defs/operator_semantics"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "MethodSpec"}}, "required": ["kind"]},
          "then": {"properties": {"semantics": {"$ref": "#/$defs/method_semantics"}}}
        }
      ]
    }
  }
}
