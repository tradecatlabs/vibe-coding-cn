{
  "api_version": "vibe-harness-cn.dev/v1alpha1",
  "kind": "OperatorPack",
  "metadata": {
    "id": "psoa.pack.historical-reasoning",
    "version": "1.0.0",
    "domain": "historical-reasoning",
    "title": "历史推理",
    "summary": "把来源批判、时间与语境、分期、交叉印证、史学视角和受约束反事实转为可审查历史解释程序。",
    "source_entry_count": 5,
    "derived_entry_count": 1
  },
  "entries": [
    {
      "id": "psoa.historical-reasoning.source-provenance-criticism",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "name": "Source Provenance Criticism",
      "name_zh": "来源与出处批判",
      "domain": "historical-reasoning",
      "status": "experimental",
      "summary": "记录作者、受众、目的、媒介、时间、保存链和历史语境，评估来源对具体问题的用途与限制。",
      "core_question": "这个来源由谁、为谁、为何、何时、以何种媒介产生，它能支持什么而不能支持什么？",
      "operation": "记录出处 → 区分观察/推断 → 评估可靠性与偏见 → 标记沉默/限制 → 回到历史语境",
      "agent_use": "让 Agent 不把档案字面内容直接当作无偏事实。",
      "applicability": {
        "when": [
          "需要用历史文献、文物、口述或档案回答关于过去的问题。"
        ],
        "not_when": [
          "只复述单一来源且不提出历史解释。"
        ]
      },
      "source_refs": [
        "ref:loc-primary-source-analysis",
        "ref:loc-reflect-inference",
        "ref:national-archives-history-in-raw"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有历史问题、时间/地点范围和来源集合。"
        ],
        "inputs": [
          "source",
          "author",
          "audience",
          "purpose",
          "date",
          "medium",
          "historical_question"
        ],
        "procedure": [
          "记录来源类型、作者/制作者、时间、受众、目的、媒介和保存链",
          "区分来源直接说了什么与研究者推断什么",
          "评估相关性、可靠性、偏见、沉默和限制",
          "把来源放回当时的制度、社会和物质环境"
        ],
        "effect": {
          "state": "historical_source_criticized",
          "statement": "形成带来源背景、用途、可靠性和限制的历史证据卡。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "来源元数据、内容观察、作者/受众/目的、上下文、可靠性与限制判断。"
        ],
        "failure_modes": [
          "把来源内容当作作者无偏的事实。",
          "忽略保存、翻译、编辑和缺失造成的偏差。"
        ],
        "recovery": [
          "补充不同类型来源并明确沉默和不确定性。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "verification-falsification",
          "secondary_classes": [
            "representation"
          ]
        }
      },
      "source_key": "historical-reasoning.source-provenance-criticism"
    },
    {
      "id": "psoa.historical-reasoning.contextualization-periodization",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "name": "Contextualization and Periodization",
      "name_zh": "历史语境化与分期",
      "domain": "historical-reasoning",
      "status": "experimental",
      "summary": "把事件放入时间、地点和更广过程，比较多个分期/转折方案并检查连续与变化。",
      "core_question": "这个事件在当时的区域、制度和长期过程中意味着什么，分期边界遮蔽了什么？",
      "operation": "Timeline → Context → Compare Periods → Test Turning Points",
      "agent_use": "让 Agent 避免用当前类别和方便日期制造线性历史。",
      "applicability": {
        "when": [
          "需要决定事件如何放入较长时间过程或比较不同分期方案。"
        ],
        "not_when": [
          "问题只需确认一个日期，不需要解释时序和转折。"
        ]
      },
      "source_refs": [
        "ref:aha-historical-thinking-skills",
        "ref:aha-history-standards"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "已有事件序列、时间范围和候选转折/过程。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "建立事件、过程、地点和参与者的时间线，并区分同时性与先后性"
          },
          {
            "order": 2,
            "instruction": "将事件连接到更广区域、制度、经济、社会或文化背景"
          },
          {
            "order": 3,
            "instruction": "提出至少两种分期/转折点方案并说明各自突出与遮蔽什么"
          },
          {
            "order": 4,
            "instruction": "用来源证据检查连续、变化、不同时间尺度的因果和历史偶然性"
          }
        ],
        "stop_conditions": [
          "日期、来源或因果顺序不可靠。",
          "分期差异只改名词，无法产生可检验解释。"
        ],
        "success_conditions": [
          "时间线、背景、连续/变化、转折证据和分期取舍明确。"
        ],
        "evidence_required": [
          "事件时间线、上下文来源、候选分期、连续/变化证据和反例。"
        ],
        "failure_modes": [
          "用现在的类别投射过去。",
          "把方便的年代边界当作自然断点。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "representation",
          "secondary_classes": [
            "verification-falsification"
          ]
        }
      },
      "source_key": "historical-reasoning.contextualization-periodization"
    },
    {
      "id": "psoa.historical-reasoning.corroboration-and-triangulation",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "name": "Historical Corroboration and Triangulation",
      "name_zh": "历史交叉印证",
      "domain": "historical-reasoning",
      "status": "experimental",
      "summary": "比较不同来源的独立性、支持、矛盾、沉默和互补，形成限定性结论。",
      "core_question": "多个来源是否真的独立，它们共同支持、彼此冲突或共同沉默了什么？",
      "operation": "Critique → Compare → Corroborate → Qualify",
      "agent_use": "把来源关系和争议显式化，而不是用来源数量投票。",
      "applicability": {
        "when": [
          "同一历史主张由多个来源、群体或传统叙述，且可能互相矛盾。"
        ],
        "not_when": [
          "只有单一来源且没有可获得的补充证据。"
        ]
      },
      "source_refs": [
        "ref:aha-historical-thinking-skills",
        "ref:national-archives-history-in-raw"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "已有待核对主张和至少两个独立或不同类型来源。"
        ],
        "steps": [
          {
            "order": 1,
            "use": "psoa.historical-reasoning.source-provenance-criticism"
          },
          {
            "order": 2,
            "instruction": "为每个来源标记独立性、作者位置、时间、目的和可观察范围"
          },
          {
            "order": 3,
            "instruction": "并列比较支持、矛盾、沉默和互补信息，避免多数票替代论证"
          },
          {
            "order": 4,
            "instruction": "形成限定性结论，写明哪部分被交叉印证、哪部分仍争议"
          }
        ],
        "stop_conditions": [
          "来源都派生自同一叙事或缺少关键独立证据。",
          "矛盾影响核心主张但无法解释来源差异。"
        ],
        "success_conditions": [
          "来源关系、交叉印证、矛盾、沉默与限定结论可追溯。"
        ],
        "evidence_required": [
          "来源卡、独立性判断、对照表、矛盾解释和结论边界。"
        ],
        "failure_modes": [
          "把来源数量当证据强度。",
          "强行消除真正的历史争议。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "verification-falsification",
          "secondary_classes": [
            "representation",
            "diagnosis-revision"
          ]
        }
      },
      "source_key": "historical-reasoning.corroboration-and-triangulation"
    },
    {
      "id": "psoa.historical-reasoning.historiographical-perspective",
      "version": "1.0.0",
      "kind": "MentalModelSpec",
      "origin": "source",
      "name": "Historiographical Perspective",
      "name_zh": "史学解释视角",
      "domain": "historical-reasoning",
      "status": "experimental",
      "summary": "把解释者的时代、制度、问题意识、证据选择和遗漏纳入比较，而不把多视角简化为立场冲突。",
      "core_question": "谁在什么语境下解释过去，哪些证据和群体被纳入或排除？",
      "operation": "标注解释位置 → 比较证据覆盖与因果机制 → 分析遗漏 → 保留合理分歧",
      "agent_use": "让 Agent 同时审查来源视角和后设历史解释。",
      "applicability": {
        "when": [
          "多个历史叙事对同一事件的选择、因果或意义不同。"
        ],
        "not_when": [
          "只需要核对来源字面内容，不讨论解释者位置。"
        ]
      },
      "source_refs": [
        "ref:aha-historical-thinking-skills",
        "ref:aha-history-standards"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "questions": [
          "谁在什么时代、制度和知识条件下解释过去？",
          "不同叙事选择了哪些证据、尺度和因果因素？",
          "哪些群体或经验被看见、被沉默或被重新命名？",
          "不同解释各自能解释什么、不能解释什么？"
        ],
        "interpretation_rules": [
          "区分来源本身的视角与后来的历史学解释。",
          "将解释放回其生产语境，不因存在视角就否定所有证据。",
          "比较多个解释的证据覆盖、因果机制和遗漏，而非只比较立场。"
        ],
        "limitations": [
          "历史解释受现存档案和当代问题意识影响。",
          "多视角不意味着所有叙事证据等价。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "representation",
          "secondary_classes": [
            "verification-falsification"
          ]
        }
      },
      "source_key": "historical-reasoning.historiographical-perspective"
    },
    {
      "id": "psoa.historical-reasoning.historical-counterfactual-boundary",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "name": "Historical Counterfactual Boundary",
      "name_zh": "历史反事实边界",
      "domain": "historical-reasoning",
      "status": "experimental",
      "summary": "只改变可描述条件，用同期资源、制度和参与者约束替代路径，并保留分支不确定性。",
      "core_question": "如果改变一个历史条件，哪些替代路径仍受当时世界约束，原主张会不会失去必要性？",
      "operation": "固定改变 → 约束时代条件 → 展开分支 → 检验主张 → 标注启发性边界",
      "agent_use": "把反事实用于检验因果而不是编造另一段确定历史。",
      "applicability": {
        "when": [
          "需要用“如果当时没有 X”探讨因果、必要条件或政策含义。"
        ],
        "not_when": [
          "反事实会被当成真实历史事实，或基线情境根本无法由史料约束。"
        ]
      },
      "source_refs": [
        "ref:aha-historical-thinking-skills",
        "ref:loc-reflect-inference"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "已有历史主张、时间点、干预变量和可观察前后条件。"
        ],
        "inputs": [
          "historical_claim",
          "counterfactual_change",
          "baseline_evidence",
          "constraints"
        ],
        "procedure": [
          "明确只改变一个或一组可描述的历史条件",
          "用当时已知资源、制度、技术和参与者行动约束替代路径",
            "列出近程、中程和不可预测的分支，不把结果写成必然",
          "用反事实结果检验原主张的必要性、充分性和不确定性"
        ],
        "effect": {
          "state": "historical_counterfactual_bounded",
          "statement": "形成受史料、时代条件和分支不确定性约束的反事实分析。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "基线史料、改变条件、时代约束、替代路径、分支和不确定性。"
        ],
        "failure_modes": [
          "把现代知识偷渡进过去的选择空间。",
          "只给单一路径，忽略偶然性和反馈。"
        ],
        "recovery": [
          "缩窄反事实、补充同期约束并明确其启发性而非事实性。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "transformation",
          "secondary_classes": [
            "verification-falsification",
            "control-metacognition"
          ]
        }
      },
      "source_key": "historical-reasoning.historical-counterfactual-boundary"
    },
    {
      "id": "psoa.historical-reasoning.historical-inquiry-loop",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "derived",
      "name": "Historical Inquiry Loop",
      "name_zh": "历史探究循环",
      "domain": "historical-reasoning",
      "status": "experimental",
      "summary": "组合来源批判、语境分期、交叉印证、史学视角和反事实边界，形成可追溯历史论证。",
      "core_question": "这个历史主张是否被合适来源、时代语境、多视角和因果边界共同支撑？",
      "operation": "Source → Context → Corroborate → Position → Bound",
      "agent_use": "作为 Agent 写历史分析、研究摘要或政策历史背景的证据流程。",
      "applicability": {
        "when": [
          "需要形成有来源、上下文、多视角和因果边界的历史解释。"
        ],
        "not_when": [
          "只需日期/事实检索，不需要解释或争议处理。"
        ]
      },
      "source_refs": [
        "ref:aha-historical-thinking-skills",
        "ref:loc-primary-source-analysis",
        "ref:national-archives-history-in-raw"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "历史问题、来源集合和时间范围已声明。"
        ],
        "steps": [
          {
            "order": 1,
            "use": "psoa.historical-reasoning.source-provenance-criticism"
          },
          {
            "order": 2,
            "use": "psoa.historical-reasoning.contextualization-periodization"
          },
          {
            "order": 3,
            "use": "psoa.historical-reasoning.corroboration-and-triangulation"
          },
          {
            "order": 4,
            "apply_model": "psoa.historical-reasoning.historiographical-perspective"
          },
          {
            "order": 5,
            "use": "psoa.historical-reasoning.historical-counterfactual-boundary"
          }
        ],
        "stop_conditions": [
          "核心来源不可核验、矛盾未解释或结论超出时间/地点证据。",
          "反事实被误当事实或历史视角被抹平。"
        ],
        "success_conditions": [
          "主张、来源、语境、分期、视角、交叉印证和因果边界清晰。"
        ],
        "evidence_required": [
          "来源批判卡、时间线/分期、交叉印证表、解释比较和反事实边界。"
        ],
        "failure_modes": [
          "把历史叙事写成单因果必然故事。",
          "用当前价值和类别覆盖历史语境。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "verification-falsification",
          "secondary_classes": [
            "representation",
            "control-metacognition"
          ]
        }
      }
    }
  ]
}
