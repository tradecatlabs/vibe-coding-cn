  "metadata": {
    "id": "psoa.pack.ethics-public-policy",
    "version": "1.0.0",
    "domain": "ethics-public-policy",
    "title": "伦理与公共政策",
    "summary": "把利益相关者、权利、公平、比例原则、伤害预防、人类监督和责任补救转为可审查的治理程序。",
    "source_entry_count": 5,
    "derived_entry_count": 1
  },
  "entries": [
    {
      "id": "psoa.ethics-public-policy.stakeholder-impact-mapping",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "name": "Stakeholder Impact Mapping",
      "name_zh": "利益相关者影响映射",
      "domain": "ethics-public-policy",
      "status": "experimental",
      "summary": "识别直接、间接、被遗漏的受影响者，并按收益、伤害、权利和不确定性建立影响地图。",
      "core_question": "谁会被系统改变处境，谁获得收益，谁承担风险，谁可能被忽略？",
      "operation": "列受影响者 → 画影响路径 → 分配收益/伤害 → 标记权利与遗漏风险 → 登记开放问题",
      "agent_use": "让 Agent 不把“用户”当成全部利益相关者，先看分配和外部性。",
      "applicability": {
        "when": [
          "系统会影响人的权利、机会、资源、隐私或安全。"
        ],
        "not_when": [
          "只做无外部影响的内部草稿，且不涉及个人或群体。"
        ]
      },
      "source_refs": [
        "ref:unesco-ai-ethics-recommendation",
        "ref:nist-ai-rmf"
      ],
      "governance": {
        "risk_level": "high",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "已描述系统目的、受影响对象和可能后果。"
        ],
        "inputs": [
          "system_purpose",
          "stakeholders",
          "potential_harms",
          "benefits",
          "rights"
        ],
        "procedure": [
          "列出直接、间接和被遗漏的利益相关者",
          "分别记录预期收益、可预见伤害、权利影响与不确定性",
          "标记谁承担风险、谁获得收益以及是否存在不可逆影响",
          "把冲突目标和需要人类裁决的事项登记为开放问题"
        ],
        "effect": {
          "state": "stakeholder_impacts_mapped",
          "statement": "形成按人群、权利、收益、伤害和不确定性组织的影响地图。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "利益相关者清单、影响路径、收益/伤害矩阵、遗漏风险与开放问题。"
        ],
        "failure_modes": [
          "只列直接用户而忽略旁观者或弱势群体。",
          "把抽象价值口号当成可审查影响。"
        ],
        "recovery": [
          "补充受影响群体访谈或代理指标，必要时暂停高影响部署"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "representation",
          "secondary_classes": [
            "verification-falsification",
            "control-metacognition"
          ]
        }
      },
      "source_key": "ethics-public-policy.stakeholder-impact-mapping"
    },
    {
      "id": "psoa.ethics-public-policy.proportionality-and-do-no-harm",
      "version": "1.0.0",
      "kind": "MentalModelSpec",
      "origin": "source",
      "name": "Proportionality and Do No Harm",
      "name_zh": "比例原则与不伤害",
      "domain": "ethics-public-policy",
      "status": "experimental",
      "summary": "用目的、必要性、替代方案、收益伤害比例和不可接受底线审查行动。",
      "core_question": "目标是否正当、必要，是否存在更低风险方案，风险是否公平分配？",
      "operation": "目的 → 必要性 → 替代方案 → 收益/伤害权衡 → 底线与补救",
      "agent_use": "让 Agent 在追求平均收益前先识别不可接受伤害和群体不平等。",
      "applicability": {
        "when": [
          "方案同时带来可量化收益与风险，或存在权利冲突。"
        ],
        "not_when": [
          "不存在可预见伤害、权利或资源分配影响。"
        ]
      },
      "source_refs": [
        "ref:unesco-ai-ethics-recommendation",
        "ref:hhs-belmont-report"
      ],
      "governance": {
        "risk_level": "high",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "questions": [
          "预期目的是否正当且必要？",
          "伤害是否与收益相称，是否有更低风险替代？",
          "风险是否被不成比例地转嫁给特定群体？",
          "哪些决定必须由人监督、解释或申诉？"
        ],
        "interpretation_rules": [
          "先说明目的和受影响对象，再比较收益、伤害、必要性和替代方案。",
          "不可接受的权利侵害不能仅用平均收益抵消。",
          "公平不仅看总体指标，也看群体差异、程序正义与补救渠道。"
        ],
        "limitations": [
          "价值判断和群体边界可能存在合理分歧。",
          "影响评估不能代替法律意见、伦理审查或真实参与。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "control-metacognition",
          "secondary_classes": [
            "verification-falsification",
            "decision"
          ]
        }
      },
      "source_key": "ethics-public-policy.proportionality-and-do-no-harm"
    },
    {
      "id": "psoa.ethics-public-policy.rights-and-fairness-screen",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "name": "Rights and Fairness Screen",
      "name_zh": "权利与公平筛查",
      "domain": "ethics-public-policy",
      "status": "experimental",
      "summary": "组合比例原则与具体权利、公平、隐私和申诉检查，避免把伦理判断压缩成单一指标。",
      "core_question": "方案是否尊重权利、程序公平、隐私和可申诉性？",
      "operation": "Rights → Fairness → Remedy → Decision",
      "agent_use": "在方案进入执行前生成权利影响、群体差异和补救证据。",
      "applicability": {
        "when": [
          "需要把系统影响转成结构化审查并形成可追溯决策。"
        ],
        "not_when": [
          "只有抽象价值宣言而没有具体系统、使用场景或影响证据。"
        ]
      },
      "source_refs": [
        "ref:unesco-ai-ethics-recommendation",
        "ref:hhs-belmont-report",
        "ref:oecd-ai-principles"
      ],
      "governance": {
        "risk_level": "high",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "已有影响地图、目的、替代方案或至少一版风险假设。"
        ],
        "steps": [
          {
            "order": 1,
            "use": "psoa.ethics-public-policy.stakeholder-impact-mapping"
          },
          {
            "order": 2,
            "apply_model": "psoa.ethics-public-policy.proportionality-and-do-no-harm"
          },
          {
            "order": 3,
            "instruction": "逐项检查权利、隐私、公平、可解释、可申诉和安全控制"
          },
          {
            "order": 4,
            "instruction": "记录剩余风险、责任人、监督点、补救方案和停止条件"
          }
        ],
        "stop_conditions": [
          "存在不可接受或无法缓解的严重伤害。",
          "关键利益相关者、权利影响或补救渠道未知。"
        ],
        "success_conditions": [
          "目的、影响、权衡、控制、责任和人类监督点均有证据与决策记录。"
        ],
        "evidence_required": [
          "影响评估、权利/公平审查、替代方案、风险处置、责任与申诉记录。"
        ],
        "failure_modes": [
          "把完成表格误当作风险已消除。",
          "只评估上线前风险，遗漏运行中漂移和二阶影响。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "verification-falsification",
          "secondary_classes": [
            "representation",
            "control-metacognition"
          ]
        }
      },
      "source_key": "ethics-public-policy.rights-and-fairness-screen"
    },
    {
      "id": "psoa.ethics-public-policy.ethical-impact-assessment",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "name": "Ethical Impact Assessment",
      "name_zh": "伦理影响评估",
      "domain": "ethics-public-policy",
      "status": "experimental",
      "summary": "以生命周期为边界评估安全、隐私、歧视、透明、可解释、环境和社会影响，并设复评触发器。",
      "core_question": "系统在何种场景、生命周期和责任结构下会造成什么影响？",
      "operation": "描述边界与数据流 → 评估影响 → 核对控制 → 设监测与复评触发器",
      "agent_use": "让 Agent 输出可复查的影响评估，而不是泛化的伦理口号。",
      "applicability": {
        "when": [
          "需要正式评估 AI/政策/产品对个人、群体和社会的影响。"
        ],
        "not_when": [
          "没有明确系统边界、部署场景或可观察影响。"
        ]
      },
      "source_refs": [
        "ref:nist-ai-rmf",
        "ref:nist-ai-rmf-playbook",
        "ref:unesco-ai-ethics-recommendation"
      ],
      "governance": {
        "risk_level": "high",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "系统用途、生命周期、责任主体和利益相关者地图可供审查。"
        ],
        "inputs": [
          "system_description",
          "lifecycle",
          "stakeholder_map",
          "rights_analysis",
          "risk_controls",
          "monitoring_plan"
        ],
        "procedure": [
          "描述系统边界、生命周期、数据流和责任主体",
          "评估安全、隐私、歧视、透明、可解释和环境/社会影响",
          "核对风险控制是否可执行、可监测、可申诉和可追责",
          "设定上线前、上线中和变更后的复评触发器"
        ],
        "effect": {
          "state": "ethical_impact_assessed",
          "statement": "生成带责任、监测和补救路径的伦理影响评估。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "系统边界、影响矩阵、控制措施、监测指标、责任/申诉和复评触发器。"
        ],
        "failure_modes": [
          "把自评声明当作独立影响证据。",
          "没有为不可逆伤害设置停止或补救路径。"
        ],
        "recovery": [
          "引入独立审查和受影响群体参与，降低范围或停止部署。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "verification-falsification",
          "secondary_classes": [
            "representation",
            "control-metacognition"
          ]
        }
      },
      "source_key": "ethics-public-policy.ethical-impact-assessment"
    },
    {
      "id": "psoa.ethics-public-policy.human-oversight-accountability",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "name": "Human Oversight and Accountability",
      "name_zh": "人类监督与责任",
      "domain": "ethics-public-policy",
      "status": "experimental",
      "summary": "把责任主体、批准/接管触发、日志解释、申诉纠错和紧急停机落成可演练控制。",
      "core_question": "谁在什么时候必须知道、批准、否决、暂停或对结果负责？",
      "operation": "Assign → Supervise → Record → Appeal → Exercise",
      "agent_use": "避免“人在环”成为没有信息和权限的形式签字。",
      "applicability": {
        "when": [
          "系统存在自动化决策、持续学习、外部行动或高影响用途。"
        ],
        "not_when": [
          "系统没有外部行动、没有受影响主体且风险可忽略。"
        ]
      },
      "source_refs": [
        "ref:unesco-ai-ethics-recommendation",
        "ref:nist-ai-rmf",
        "ref:oecd-ai-principles"
      ],
      "governance": {
        "risk_level": "high",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "已识别关键决策、责任主体、监督能力和升级通道。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "为每个高影响决策指定可负责的人或机构、权限边界和记录要求"
          },
          {
            "order": 2,
            "instruction": "定义人类何时必须批准、复核、否决、暂停或接管系统"
          },
          {
            "order": 3,
            "instruction": "验证日志、解释、申诉、纠错和事故通报能够被实际使用"
          },
          {
            "order": 4,
            "instruction": "演练监督失效、模型漂移、误用和紧急停机情景"
          }
        ],
        "stop_conditions": [
          "没有可识别责任主体或监督者无法获得足够信息/权限。",
          "申诉、纠错或停机路径不可用。"
        ],
        "success_conditions": [
          "责任、监督、审计、申诉和紧急接管在具体场景中可执行。"
        ],
        "evidence_required": [
          "责任矩阵、监督触发规则、日志/解释样例、申诉和停机演练记录。"
        ],
        "failure_modes": [
          "把人在环写成形式批准而不具备真实干预能力。",
          "责任分散到无人负责。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "control-metacognition",
          "secondary_classes": [
            "verification-falsification"
          ]
        }
      },
      "source_key": "ethics-public-policy.human-oversight-accountability"
    },
    {
      "id": "psoa.ethics-public-policy.ethical-governance-review-loop",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "derived",
      "name": "Ethical Governance Review Loop",
      "name_zh": "伦理治理审查循环",
      "domain": "ethics-public-policy",
      "status": "experimental",
      "summary": "组合影响映射、伦理影响评估、监督责任和权利公平筛查，形成高影响方案的只读治理证据链。",
      "core_question": "这个方案的影响、权利、公平、责任、监督和补救是否都可追溯？",
      "operation": "Map → Assess → Assign → Screen",
      "agent_use": "作为 Agent 提出高影响方案前的治理门槛。",
      "applicability": {
        "when": [
          "需要评估高影响 AI、公共政策或自动化治理方案。"
        ],
        "not_when": [
          "只需要一般性创意发散，且没有外部影响。"
        ]
      },
      "source_refs": [
        "ref:unesco-ai-ethics-recommendation",
        "ref:nist-ai-rmf",
        "ref:hhs-belmont-report"
      ],
      "governance": {
        "risk_level": "high",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "目标、利益相关者、潜在影响和评估资源已声明。"
        ],
        "steps": [
          {
            "order": 1,
            "use": "psoa.ethics-public-policy.stakeholder-impact-mapping"
          },
          {
            "order": 2,
            "use": "psoa.ethics-public-policy.ethical-impact-assessment"
          },
          {
            "order": 3,
            "use": "psoa.ethics-public-policy.human-oversight-accountability"
          },
          {
            "order": 4,
            "use": "psoa.ethics-public-policy.rights-and-fairness-screen"
          }
        ],
        "stop_conditions": [
          "不可接受风险未缓解，或监督/申诉/责任路径缺失。",
          "结论高度依赖未解决的价值分歧或缺失群体证据。"
        ],
        "success_conditions": [
          "影响、权利、公平、责任、监督、补救和剩余不确定性均明确。"
        ],
        "evidence_required": [
          "利益相关者地图、影响评估、权利公平审查、监督责任矩阵和复评触发器。"
        ],
        "failure_modes": [
          "把伦理审查通过误称为系统安全或法律合规证明。",
          "忽略部署后反馈与二阶影响。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "control-metacognition",
          "secondary_classes": [
            "representation",
            "verification-falsification"
          ]
        }
      }
    }
  ]
}
