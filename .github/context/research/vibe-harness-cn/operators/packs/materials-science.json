{
  "api_version": "vibe-harness-cn.dev/v1alpha1",
  "kind": "OperatorPack",
  "metadata": {
    "id": "psoa.pack.materials-science",
    "version": "1.0.0",
    "domain": "materials-science",
    "title": "材料科学与工程测量",
    "summary": "把加工—结构—性能链、材料计量、数据质量、校准和设计迭代转为可审计程序。",
    "source_entry_count": 5,
    "derived_entry_count": 1
  },
  "entries": [
    {
      "id": "psoa.materials-science.processing-structure-property-map",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "source_key": "materials-science.processing-structure-property-map",
      "name": "Processing Structure Property Map",
      "name_zh": "加工—结构—性能映射",
      "domain": "materials-science",
      "status": "experimental",
      "summary": "沿加工条件、微观/宏观结构、材料性能和最终表现建立因果候选链。",
      "core_question": "改变加工过程通过什么结构变化影响性能，证据在哪一层？",
      "operation": "定义加工变量 → 表征结构 → 测量性能 → 对齐尺度与因果顺序 → 标出替代机制",
      "agent_use": "避免 Agent 只看最终性能而忽略过程和结构中间层。",
      "applicability": {
        "when": [
          "材料问题同时涉及制备、结构和性能。"
        ],
        "not_when": [
          "只有单次结果且没有过程或结构信息。"
        ]
      },
      "source_refs": [
        "ref:nist-materials-science-engineering",
        "ref:nist-cementitious-materials"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "加工变量、结构表征、性能指标和样品身份可对齐。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "定义加工路径、边界条件和批次差异"
          },
          {
            "order": 2,
            "instruction": "选择与机制相关的结构/化学表征"
          },
          {
            "order": 3,
            "instruction": "测量性能并记录环境、方向和时间条件"
          },
          {
            "order": 4,
            "instruction": "建立加工→结构→性能→表现映射，标出相关而非因果证据"
          }
        ],
        "stop_conditions": [
          "样品身份、结构表征或性能测量无法对齐。"
        ],
        "success_conditions": [
          "每个性能变化都有过程、结构和替代解释记录。"
        ],
        "evidence_required": [
          "样品/批次、加工参数、结构数据、性能数据、环境和映射假设。"
        ],
        "failure_modes": [
          "用相关性跳过结构中间层。",
          "忽略批次和尺度差异。"
        ]
      }
    },
    {
      "id": "psoa.materials-science.materials-metrology-traceability",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "source_key": "materials-science.materials-metrology-traceability",
      "name": "Materials Metrology Traceability",
      "name_zh": "材料计量可追溯性",
      "domain": "materials-science",
      "status": "experimental",
      "summary": "把测量对象、方法、标准、仪器、校准、单位和不确定度连接成可追溯测量链。",
      "core_question": "这个材料数值由什么测量得到，能否追溯到标准和不确定度？",
      "operation": "定义 measurand → 固定方法/仪器 → 使用标准校准 → 记录不确定度 → 链路审计",
      "agent_use": "防止 Agent 把不同测量条件下的材料数值直接横向比较。",
      "applicability": {
        "when": [
          "材料数据用于比较、规格、模型或决策。"
        ],
        "not_when": [
          "只做无量纲概念讨论。"
        ]
      },
      "source_refs": [
        "ref:nist-materials-measurement-lab",
        "ref:nist-materials-data-evaluation"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "测量量、方法、仪器、标准和样品已定义。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "定义 measurand、样品状态、单位和报告精度"
          },
          {
            "order": 2,
            "instruction": "记录仪器、方法、标准物质和校准链"
          },
          {
            "order": 3,
            "instruction": "估计随机/系统不确定度与相关性"
          },
          {
            "order": 4,
            "instruction": "核对不同数据是否在同一测量语义下可比较"
          }
        ],
        "stop_conditions": [
          "校准链、样品状态或不确定度缺失。"
        ],
        "success_conditions": [
          "结果可追溯到方法、标准、仪器和不确定度。"
        ],
        "evidence_required": [
          "measurand、方法、仪器、标准、校准、单位、不确定度和样品状态。"
        ],
        "failure_modes": [
          "把名义精度当真实准确度。",
          "比较不同测量定义。"
        ]
      }
    },
    {
      "id": "psoa.materials-science.microstructure-characterization",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "source_key": "materials-science.microstructure-characterization",
      "name": "Microstructure Characterization",
      "name_zh": "微观结构表征",
      "domain": "materials-science",
      "status": "experimental",
      "summary": "用跨尺度、原位/离位和互补技术描述相组成、缺陷、纹理、界面和空间变异。",
      "core_question": "性能差异对应哪一种结构特征，表征方法能看见它吗？",
      "operation": "提出机制候选 → 选互补表征 → 记录尺度/分辨率 → 对齐结构与性能 → 检查代表性",
      "agent_use": "让 Agent 先确认“看到了什么”，再谈材料机制。",
      "applicability": {
        "when": [
          "性能或失效可能由微结构和空间异质性驱动。"
        ],
        "not_when": [
          "问题只要求宏观标签且机制不在范围内。"
        ]
      },
      "source_refs": [
        "ref:nist-microstructure-property-tools",
        "ref:nist-structural-metrology"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有样品、候选结构特征和可用表征方法。"
        ],
        "inputs": [
          "samples",
          "candidate_features",
          "characterization_methods",
          "performance_data"
        ],
        "procedure": [
          "根据候选机制选择互补表征方法",
          "记录分辨率、取样位置、制样和原位/离位条件",
          "量化相、缺陷、界面和空间变异",
          "把结构指标与性能/失效位置配对并检查代表性"
        ],
        "effect": {
          "state": "microstructure_evidence",
          "statement": "形成可对齐性能的结构特征、尺度、变异和限制。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "样品批次、表征方法、尺度/分辨率、原始图谱/图像、统计和性能配对。"
        ],
        "failure_modes": [
          "单点图像代表整批材料。",
          "制样伪影被当真实结构。"
        ],
        "recovery": [
          "增加取样、换互补方法或标注表征盲区。"
        ]
      }
    },
    {
      "id": "psoa.materials-science.data-quality-evaluation",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "source_key": "materials-science.data-quality-evaluation",
      "name": "Materials Data Quality Evaluation",
      "name_zh": "材料数据质量评估",
      "domain": "materials-science",
      "status": "experimental",
      "summary": "按可靠性、完整性、一致性、可重复性、可预测性和用途区分数据质量与证据强度。",
      "core_question": "这个数值能否支持当前比较、模型或设计决策？",
      "operation": "列用途 → 审数据来源/方法 → 查一致性与重复性 → 标质量等级与适用边界",
      "agent_use": "防止 Agent 只按数据量或小数位数判断材料数据可信度。",
      "applicability": {
        "when": [
          "需要汇总、建模或比较异质材料数据。"
        ],
        "not_when": [
          "数据只作未经解释的原始记录。"
        ]
      },
      "source_refs": [
        "ref:nist-materials-data-evaluation",
        "ref:nist-materials-measurement-lab"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有数据集、来源、测量/计算方法和预期用途。"
        ],
        "procedure": [
          "定义数据用途和所需精度",
          "审查来源、测量过程、完整性、单位和元数据",
          "比较独立方法、重复测量和物理一致性",
          "区分 definitive、correlation、heuristic 和 value estimates，并写适用范围"
        ],
        "effect": {
          "state": "materials_data_quality_bounded",
          "statement": "形成数据质量等级、缺口、用途和不可推断范围。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "数据来源、方法、元数据、重复性、交叉比较、质量等级和用途。"
        ],
        "failure_modes": [
          "相关数据被写成定论。",
          "缺元数据仍进入精密模型。"
        ],
        "recovery": [
          "补元数据、重复测量或降低数据角色。"
        ],
        "inputs": [
          "artifact",
          "constraints",
          "evidence"
        ]
      }
    },
    {
      "id": "psoa.materials-science.qualification-and-calibration",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "source_key": "materials-science.qualification-and-calibration",
      "name": "Qualification and Calibration",
      "name_zh": "材料资格确认与校准",
      "domain": "materials-science",
      "status": "experimental",
      "summary": "通过标准样、基准样、过程窗口和独立测试确认材料/测量流程在目标用途下可用。",
      "core_question": "这套材料或测量流程在目标条件下是否稳定、可重复、可校准？",
      "operation": "定义用途/指标 → 选标准与基准 → 校准/验证 → 压力测试 → 记录放行边界",
      "agent_use": "让 Agent 先做资格确认，再把材料性能用于更高风险推断。",
      "applicability": {
        "when": [
          "材料、工艺或测量流程要进入比较、模型或应用。"
        ],
        "not_when": [
          "仅做探索性概念设计且没有放行结论。"
        ]
      },
      "source_refs": [
        "ref:nist-structural-metrology",
        "ref:nist-materials-measurement-lab",
        "ref:nist-materials-data-evaluation"
      ],
      "governance": {
        "risk_level": "high",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "目标用途、指标、标准样和可接受范围已声明。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "定义目标用途、性能指标、环境和容差"
          },
          {
            "order": 2,
            "instruction": "选择标准/基准样并建立校准链"
          },
          {
            "order": 3,
            "instruction": "在目标和边界条件下做重复、独立和压力测试"
          },
          {
            "order": 4,
            "instruction": "根据结果声明合格、条件合格或不合格边界"
          }
        ],
        "stop_conditions": [
          "校准不能追溯、重复性不足或压力条件超出安全边界。"
        ],
        "success_conditions": [
          "目标条件、测试证据、容差和放行边界明确。"
        ],
        "evidence_required": [
          "用途、标准样、校准、重复性、压力条件、统计结果和放行规则。"
        ],
        "failure_modes": [
          "实验室性能外推到未测试环境。",
          "把一次通过当长期稳定。"
        ]
      }
    },
    {
      "id": "psoa.materials-science.materials-design-loop",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "derived",
      "name": "Materials Design Loop",
      "name_zh": "材料设计循环",
      "domain": "materials-science",
      "status": "experimental",
      "summary": "组合加工—结构—性能映射、计量追溯、微结构表征、数据质量评估和资格校准，形成材料设计闭环。",
      "core_question": "候选材料的性能提升是否由可追溯、可重复、可校准的结构变化支持？",
      "operation": "Process→Characterize→Measure→Evaluate Data→Qualify/Calibrate",
      "agent_use": "让 Agent 在材料设计中同时管理机制、测量、数据和放行边界。",
      "applicability": {
        "when": [
          "需要从材料候选或工艺候选走向受限设计结论。"
        ],
        "not_when": [
          "没有样品、测量或用途约束。"
        ]
      },
      "source_refs": [
        "ref:nist-materials-science-engineering",
        "ref:nist-materials-data-evaluation",
        "ref:nist-structural-metrology"
      ],
      "governance": {
        "risk_level": "high",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有材料候选、加工路径、表征/测量方案和目标用途。"
        ],
        "steps": [
          {
            "order": 1,
            "use": "psoa.materials-science.processing-structure-property-map"
          },
          {
            "order": 2,
            "use": "psoa.materials-science.materials-metrology-traceability"
          },
          {
            "order": 3,
            "use": "psoa.materials-science.microstructure-characterization"
          },
          {
            "order": 4,
            "use": "psoa.materials-science.data-quality-evaluation"
          },
          {
            "order": 5,
            "use": "psoa.materials-science.qualification-and-calibration"
          }
        ],
        "stop_conditions": [
          "结构机制、计量链、数据质量或资格测试不满足目标用途。"
        ],
        "success_conditions": [
          "加工—结构—性能链、测量不确定度、数据质量和放行边界均有证据。"
        ],
        "evidence_required": [
          "过程、结构、性能、计量、数据评价、校准和资格结果。"
        ],
        "failure_modes": [
          "把相关性、单样本或未校准数据当设计依据。"
        ]
      }
    }
  ]
}
