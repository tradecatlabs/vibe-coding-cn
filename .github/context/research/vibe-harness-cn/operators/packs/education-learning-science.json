{
  "api_version": "vibe-harness-cn.dev/v1alpha1",
  "kind": "OperatorPack",
  "metadata": {
    "id": "psoa.pack.education-learning-science",
    "version": "1.0.0",
    "domain": "education-learning-science",
    "title": "教育与学习科学",
    "summary": "把学习目标、先备知识、误解诊断、提取练习、支架淡出和形成性反馈转为可观察的学习设计程序。",
    "source_entry_count": 5,
    "derived_entry_count": 1
  },
  "entries": [
    {
      "id": "psoa.education-learning-science.learning-objective-operationalization",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "name": "Learning Objective Operationalization",
      "name_zh": "学习目标操作化",
      "domain": "education-learning-science",
      "status": "experimental",
      "summary": "把模糊学习愿望改写成可观察行为、条件、标准和可接受证据。",
      "core_question": "学习者最后要能在什么条件下做出什么行为，做到什么程度？",
      "operation": "行为化描述 → 规定条件与标准 → 对齐活动/评估 → 标记不可测部分",
      "agent_use": "阻止 Agent 用“理解/掌握”掩盖不可验证目标。",
      "applicability": {
        "when": [
          "需要把模糊学习愿望变成可观察、可评估的能力目标。"
        ],
        "not_when": [
          "只做内容罗列，不需要学习者表现或评估。"
        ]
      },
      "source_refs": [
        "ref:nasem-how-people-learn-ii",
        "ref:ies-wwc-retrieval-practice"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "已有学习主题、对象和期望变化的初稿。"
        ],
        "inputs": [
          "learner_profile",
          "topic",
          "desired_capability",
          "constraints"
        ],
        "procedure": [
          "用可观察行为描述学习者要能做什么",
          "规定条件、质量标准、证据形式和成功阈值",
          "检查目标是否与活动、练习和评估一致",
          "标记超出当前资源或先备知识的目标"
        ],
        "effect": {
          "state": "learning_objective_operationalized",
          "statement": "形成可观察、可评估并与学习活动对齐的目标。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "目标行为、条件、标准、评估证据和对齐关系。"
        ],
        "failure_modes": [
          "使用理解、掌握等不可观察动词。",
          "目标过宽，无法选择练习和证据。"
        ],
        "recovery": [
          "缩小目标到一个可演示能力，补充先备知识和评估方式。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "representation",
          "secondary_classes": [
            "control-metacognition"
          ]
        }
      },
      "source_key": "education-learning-science.learning-objective-operationalization"
    },
    {
      "id": "psoa.education-learning-science.prior-knowledge-misconception-check",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "name": "Prior Knowledge and Misconception Check",
      "name_zh": "先备知识与误解检查",
      "domain": "education-learning-science",
      "status": "experimental",
      "summary": "从表现、解释和变式诊断学习者的起点、误解和策略失配。",
      "core_question": "当前错误是不会、误解、策略不匹配，还是情境/注意因素造成的？",
      "operation": "列先备概念 → 采样表现 → 设计最小诊断 → 区分竞争解释 → 更新学习起点",
      "agent_use": "让 Agent 先诊断学习起点，再安排内容和难度。",
      "applicability": {
        "when": [
          "学习结果异常、迁移失败或同一错误重复出现。"
        ],
        "not_when": [
          "学习目标、任务表现和学习者背景都没有可观察资料。"
        ]
      },
      "source_refs": [
        "ref:nasem-how-people-learn-ii",
        "ref:govuk-science-learning-review"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有学习者已有知识、错误答案、解释或表现样本。"
        ],
        "inputs": [
          "prior_knowledge",
          "misconceptions",
          "performance_samples",
          "context"
        ],
        "procedure": [
          "列出学习任务需要的先备概念",
          "从表现和解释中区分未知、误解、策略失配与粗心错误",
          "设计最小诊断问题验证竞争解释",
          "把结果写入后续教学顺序和反馈策略"
        ],
        "effect": {
          "state": "prior_knowledge_profiled",
          "statement": "形成先备知识、误解和诊断证据的学习起点画像。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "先备知识假设、表现样本、诊断题、误解证据和置信度。"
        ],
        "failure_modes": [
          "把答错直接解释为不会。",
          "只用一次测验推断稳定误解。"
        ],
        "recovery": [
          "增加变式任务、口头解释和间隔复测，区分情境因素。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "diagnosis-revision",
          "secondary_classes": [
            "representation",
            "control-metacognition"
          ]
        }
      },
      "source_key": "education-learning-science.prior-knowledge-misconception-check"
    },
    {
      "id": "psoa.education-learning-science.retrieval-and-application-practice",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "name": "Retrieval and Application Practice",
      "name_zh": "提取与应用练习",
      "domain": "education-learning-science",
      "status": "experimental",
      "summary": "结合间隔、主动提取、交错变式和新情境应用，检验保留与迁移而非熟悉感。",
      "core_question": "学习者能否在没有提示的新情境中提取并应用目标能力？",
      "operation": "Diagnose → Retrieve → Vary → Apply",
      "agent_use": "把学习过程变成有反馈、可迁移的练习循环。",
      "applicability": {
        "when": [
          "需要让学习者长期保留并迁移知识或技能。"
        ],
        "not_when": [
          "只需一次性展示信息，不关心保留、迁移或自我调节。"
        ]
      },
      "source_refs": [
        "ref:ies-wwc-retrieval-practice",
        "ref:nasem-how-people-learn-ii"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "学习目标和先备知识至少有初稿。"
        ],
        "steps": [
          {
            "order": 1,
            "use": "psoa.education-learning-science.learning-objective-operationalization"
          },
          {
            "order": 2,
            "use": "psoa.education-learning-science.prior-knowledge-misconception-check"
          },
          {
            "order": 3,
            "instruction": "安排间隔练习、主动提取、交错变式，并逐步从示例推进到独立解题"
          },
          {
            "order": 4,
            "instruction": "在新情境中要求应用并记录错误类型、迁移证据和自我判断"
          }
        ],
        "stop_conditions": [
          "目标或先备知识仍不清楚，练习无法解释要改变的能力。",
          "学习者出现持续伤害性负荷或反馈无法被理解。"
        ],
        "success_conditions": [
          "目标、先备诊断、练习序列、迁移任务和学习证据相互对齐。"
        ],
        "evidence_required": [
          "目标—活动对齐表、诊断结果、练习间隔/变式计划、迁移表现和反馈记录。"
        ],
        "failure_modes": [
          "只增加内容量而不增加提取和应用机会。",
          "把熟悉感当作掌握。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "construction",
          "secondary_classes": [
            "control-metacognition",
            "verification-falsification"
          ]
        }
      },
      "source_key": "education-learning-science.retrieval-and-application-practice"
    },
    {
      "id": "psoa.education-learning-science.scaffold-and-fade",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "name": "Scaffold and Fade",
      "name_zh": "支架与淡出",
      "domain": "education-learning-science",
      "status": "experimental",
      "summary": "从示例和提示开始，根据表现逐步减少支持并检查独立迁移。",
      "core_question": "什么时候应该提供、保留、减少或恢复支架？",
      "operation": "Model → Guided Practice → Fade → Transfer",
      "agent_use": "让 Agent 不把一次示范当作独立能力证据。",
      "applicability": {
        "when": [
          "学习者需要从示范/支架逐步转向独立完成任务。"
        ],
        "not_when": [
          "任务没有可拆分步骤或不允许逐步撤除支持。"
        ]
      },
      "source_refs": [
        "ref:ies-wwc-retrieval-practice",
        "ref:eef-metacognition"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "任务步骤、常见错误和学习者当前能力可描述。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "展示完整示例或清晰策略，并解释关键决策点"
          },
          {
            "order": 2,
            "instruction": "让学习者在保留提示、检查表或部分解答的情况下练习"
          },
          {
            "order": 3,
            "instruction": "根据表现逐步减少提示，增加变式与独立选择"
          },
          {
            "order": 4,
            "instruction": "在新情境中评估独立表现，并按需要恢复最小支架"
          }
        ],
        "stop_conditions": [
          "学习者尚未理解核心策略却继续撤除支架。",
          "支架遮蔽了真实能力，无法观察独立表现。"
        ],
        "success_conditions": [
          "支架随能力证据逐步淡出，独立迁移表现达到目标标准。"
        ],
        "evidence_required": [
          "示例/支架版本、撤除条件、独立任务表现和错误修复记录。"
        ],
        "failure_modes": [
          "支架永久存在导致依赖。",
          "撤除过快造成无效挫败或错误固化。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "control-metacognition",
          "secondary_classes": [
            "construction",
            "diagnosis-revision"
          ]
        }
      },
      "source_key": "education-learning-science.scaffold-and-fade"
    },
    {
      "id": "psoa.education-learning-science.formative-assessment-feedback",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "name": "Formative Assessment and Feedback",
      "name_zh": "形成性评估与反馈",
      "domain": "education-learning-science",
      "status": "experimental",
      "summary": "将目标、输出、差距、可行动反馈和复测绑定，形成短反馈回路。",
      "core_question": "学习者当前离目标差多少，下一次具体改什么，改后是否真的更好？",
      "operation": "对齐目标 → 定位差距 → 给行动反馈 → 自评/重做 → 变式复测",
      "agent_use": "让 Agent 反馈可执行并有后续证据，而不是只给分数或答案。",
      "applicability": {
        "when": [
          "需要用表现证据调整教学、练习或反馈。"
        ],
        "not_when": [
          "没有明确学习目标、学习者输出或可采取的后续行动。"
        ]
      },
      "source_refs": [
        "ref:eef-feedback",
        "ref:govuk-science-learning-review"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "目标、当前表现和反馈时机已定义。"
        ],
        "inputs": [
          "learning_goal",
          "learner_output",
          "error_pattern",
          "feedback_budget"
        ],
        "procedure": [
          "比较目标与实际表现，定位具体差距而非只给总分",
          "给出指向任务、策略或概念的可行动反馈",
          "让学习者先自评/解释，再提供纠正和下一步练习",
          "复测相同能力的变式任务，检查反馈是否改变表现"
        ],
        "effect": {
          "state": "formative_feedback_applied",
          "statement": "形成目标对齐、可行动并经过复测的形成性反馈闭环。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "目标、输出样本、差距诊断、反馈内容、后续行动和复测结果。"
        ],
        "failure_modes": [
          "反馈只评价人或给出答案，不指出差距和下一步。",
          "反馈太晚，无法用于下一次尝试。"
        ],
        "recovery": [
          "缩短反馈回路，先处理最关键错误并要求立即重做。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "control-metacognition",
          "secondary_classes": [
            "diagnosis-revision",
            "verification-falsification"
          ]
        }
      },
      "source_key": "education-learning-science.formative-assessment-feedback"
    },
    {
      "id": "psoa.education-learning-science.learning-design-loop",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "derived",
      "name": "Learning Design Loop",
      "name_zh": "学习设计循环",
      "domain": "education-learning-science",
      "status": "experimental",
      "summary": "组合目标操作化、起点诊断、提取应用、支架淡出和形成性反馈，形成学习闭环。",
      "core_question": "这段教学是否真的改变了可迁移能力，而不是只让内容看起来熟悉？",
      "operation": "Specify → Diagnose → Practice → Fade → Feedback",
      "agent_use": "作为 Agent 生成课程、教程或训练任务前的结构化检查。",
      "applicability": {
        "when": [
          "需要设计或审查一段可迁移、可评估的学习流程。"
        ],
        "not_when": [
          "只生成静态知识摘要，不包含学习者练习和证据。"
        ]
      },
      "source_refs": [
        "ref:nasem-how-people-learn-ii",
        "ref:ies-wwc-retrieval-practice",
        "ref:eef-feedback"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "学习目标、学习者起点和资源限制已声明。"
        ],
        "steps": [
          {
            "order": 1,
            "use": "psoa.education-learning-science.learning-objective-operationalization"
          },
          {
            "order": 2,
            "use": "psoa.education-learning-science.prior-knowledge-misconception-check"
          },
          {
            "order": 3,
            "use": "psoa.education-learning-science.retrieval-and-application-practice"
          },
          {
            "order": 4,
            "use": "psoa.education-learning-science.scaffold-and-fade"
          },
          {
            "order": 5,
            "use": "psoa.education-learning-science.formative-assessment-feedback"
          }
        ],
        "stop_conditions": [
          "目标、练习、反馈或迁移证据缺一项。",
          "学习负荷或公平约束被忽略。"
        ],
        "success_conditions": [
          "学习起点、目标、练习、支架、反馈和迁移评估形成可追踪闭环。"
        ],
        "evidence_required": [
          "目标对齐、诊断、练习序列、支架淡出、反馈与复测证据。"
        ],
        "failure_modes": [
          "把完成课程或生成答案误当学习发生。",
          "没有留出集或迁移任务，导致熟悉感过拟合。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "control-metacognition",
          "secondary_classes": [
            "representation",
            "verification-falsification"
          ]
        }
      }
    }
  ]
}
