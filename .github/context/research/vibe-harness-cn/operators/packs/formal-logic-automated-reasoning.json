{
  "api_version": "vibe-harness-cn.dev/v1alpha1",
  "kind": "OperatorPack",
  "metadata": {
    "id": "psoa.pack.formal-logic-automated-reasoning",
    "version": "1.0.0",
    "domain": "formal-logic-automated-reasoning",
    "title": "形式逻辑与自动推理",
    "summary": "把命题定义、可满足性、证明分解和内核核验转为可追溯推理程序。",
    "source_entry_count": 5,
    "derived_entry_count": 1
  },
  "entries": [
    {
      "id": "psoa.formal-logic-automated-reasoning.formal-problem-specification",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "source_key": "formal-logic-automated-reasoning.formal-problem-specification",
      "name": "Formal Problem Specification",
      "name_zh": "形式问题规约",
      "domain": "formal-logic-automated-reasoning",
      "status": "experimental",
      "summary": "把目标、对象、语法、语义和约束写成可检查的形式问题。",
      "core_question": "当前主张的对象、语义和成功条件分别是什么？",
      "operation": "定义符号与类型 → 声明语义与约束 → 区分目标和假设 → 生成可检查问题",
      "agent_use": "让 Agent 在推理前暴露隐含定义和范围。",
      "applicability": {
        "when": [
          "主张含有可形式化对象、规则或约束。"
        ],
        "not_when": [
          "没有稳定术语或形式语义无法表达。"
        ]
      },
      "source_refs": [
        "ref:lean-language-reference",
        "ref:sep-classical-logic"
      ],
      "governance": {
        "risk_level": "low",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "已有待证明/判定的主张和候选符号。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "列出对象、类型、符号、假设和目标"
          },
          {
            "order": 2,
            "instruction": "为符号指定语法与语义解释"
          },
          {
            "order": 3,
            "instruction": "区分可满足、有效、蕴涵和不可判定问题"
          },
          {
            "order": 4,
            "instruction": "检查问题是否闭合、无歧义且可产生证据"
          }
        ],
        "stop_conditions": [
          "关键符号未定义或语义存在多个未标注解释。"
        ],
        "success_conditions": [
          "形式问题、假设、目标和判定标准可被独立复述。"
        ],
        "evidence_required": [
          "符号表、类型/语义、假设、目标和判定关系。"
        ],
        "failure_modes": [
          "把自然语言直觉当作形式语义。",
          "把可满足误写成有效。"
        ]
      }
    },
    {
      "id": "psoa.formal-logic-automated-reasoning.syntax-semantics-separation",
      "version": "1.0.0",
      "kind": "MentalModelSpec",
      "origin": "source",
      "source_key": "formal-logic-automated-reasoning.syntax-semantics-separation",
      "name": "Syntax Semantics Separation",
      "name_zh": "语法语义分离",
      "domain": "formal-logic-automated-reasoning",
      "status": "experimental",
      "summary": "把表达式的合法形状与它在模型中的含义分开审查。",
      "core_question": "这是一个合法表达式，还是一个在指定模型中为真的表达式？",
      "operation": "先检查形式合法性，再指定解释与模型，最后判断真值/蕴涵。",
      "agent_use": "避免 Agent 因句子看起来像结论就跳过语义核对。",
      "applicability": {
        "when": [
          "同一符号可能在不同模型中有不同解释。"
        ],
        "not_when": [
          "对象只有单一固定的机械编码含义。"
        ]
      },
      "source_refs": [
        "ref:sep-classical-logic",
        "ref:lean-language-reference"
      ],
      "governance": {
        "risk_level": "low",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "questions": [
          "表达式是否符合语法？",
          "解释是否明确？",
          "结论对所有模型成立还是只对一个模型成立？"
        ],
        "interpretation_rules": [
          "先验证 well-formed，再讨论 truth/validity",
          "区分模型内真值与逻辑有效性",
          "把未指定解释标成未知"
        ],
        "limitations": [
          "形式化不能自动解决现实概念边界或价值选择。"
        ]
      }
    },
    {
      "id": "psoa.formal-logic-automated-reasoning.satisfiability-countermodel-search",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "source_key": "formal-logic-automated-reasoning.satisfiability-countermodel-search",
      "name": "Satisfiability and Countermodel Search",
      "name_zh": "可满足性与反模型搜索",
      "domain": "formal-logic-automated-reasoning",
      "status": "experimental",
      "summary": "通过构造模型或反模型区分存在一个满足解释与所有解释都成立。",
      "core_question": "是否存在满足全部约束的模型，或存在一个能推翻主张的反模型？",
      "operation": "列约束 → 分支赋值/模型 → 传播冲突 → 保留模型或反模型证据",
      "agent_use": "把普遍断言转为可搜索的反例任务。",
      "applicability": {
        "when": [
          "主张可表达为约束、公式或有限模型。"
        ],
        "not_when": [
          "缺少可判定语义或搜索空间未定义。"
        ]
      },
      "source_refs": [
        "ref:sep-classical-logic",
        "ref:sep-computational-complexity"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "公式、变量域和约束集合已定义。"
        ],
        "inputs": [
          "formula",
          "variables",
          "constraints",
          "model_domain"
        ],
        "procedure": [
          "把主张改写为满足性或有效性问题",
          "选择赋值/模型并逐步传播约束",
          "遇到冲突记录冲突核并剪枝",
          "输出满足模型、反模型或未判定原因"
        ],
        "effect": {
          "state": "satisfiability_status",
          "statement": "形成模型、反模型或带边界的不可判定结果。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "公式、变量域、赋值/模型、冲突或反模型和搜索边界。"
        ],
        "failure_modes": [
          "把搜索耗尽误写成不可满足。",
          "模型域过窄导致假反例。"
        ],
        "recovery": [
          "扩大模型域、拆分约束或标注资源上限。"
        ]
      }
    },
    {
      "id": "psoa.formal-logic-automated-reasoning.proof-state-subgoal-decomposition",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "source_key": "formal-logic-automated-reasoning.proof-state-subgoal-decomposition",
      "name": "Proof State Subgoal Decomposition",
      "name_zh": "证明状态子目标分解",
      "domain": "formal-logic-automated-reasoning",
      "status": "experimental",
      "summary": "把一个证明目标按假设、构造、归纳或重写拆成可分别检查的子目标。",
      "core_question": "当前目标需要哪些更小的目标和局部假设？",
      "operation": "读取目标状态 → 选择分解规则 → 生成子目标 → 逐个关闭并保留依赖关系",
      "agent_use": "让长推理暴露中间义务，而不是只给最终结论。",
      "applicability": {
        "when": [
          "目标能由合取、蕴涵、量词、结构递归或等式重写分解。"
        ],
        "not_when": [
          "没有明确目标状态或分解会丢失依赖。"
        ]
      },
      "source_refs": [
        "ref:lean-tactic-proofs",
        "ref:lean-proof-states"
      ],
      "governance": {
        "risk_level": "low",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有目标、局部上下文和允许的推理规则。"
        ],
        "inputs": [
          "goal",
          "context",
          "decomposition_rules"
        ],
        "procedure": [
          "记录初始目标和上下文",
          "按结构选择 intro/apply/cases/induction/rewrite 等分解",
          "为每个子目标记录来源和剩余假设",
          "只有所有子目标完成才声明总目标完成"
        ],
        "effect": {
          "state": "proof_subgoals_expanded",
          "statement": "形成可追踪的子目标树和依赖上下文。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "初始目标、分解规则、子目标树、上下文和关闭证据。"
        ],
        "failure_modes": [
          "分解规则不保持目标等价。",
          "遗漏一个子目标仍宣布完成。"
        ],
        "recovery": [
          "回退到最近证明状态并改用保守分解。"
        ]
      }
    },
    {
      "id": "psoa.formal-logic-automated-reasoning.kernel-checked-proof-evidence",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "source_key": "formal-logic-automated-reasoning.kernel-checked-proof-evidence",
      "name": "Kernel Checked Proof Evidence",
      "name_zh": "内核核验的证明证据",
      "domain": "formal-logic-automated-reasoning",
      "status": "experimental",
      "summary": "把自动化搜索产生的证明对象交给小型可信检查器复核，而不是信任搜索器自报成功。",
      "core_question": "结果是否能被独立、最小且确定性的检查器重新验证？",
      "operation": "生成证明项 → 固定环境与版本 → 独立内核检查 → 保存失败位置和证明摘要",
      "agent_use": "为 Agent 的高置信推理提供可复核证据层。",
      "applicability": {
        "when": [
          "存在形式证明项、检查器或可重放的证明证据。"
        ],
        "not_when": [
          "结论无法给出可检查见证。"
        ]
      },
      "source_refs": [
        "ref:lean-language-reference",
        "ref:lean-tactic-proofs"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "主张、证明项、检查器版本和依赖环境已固定。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "保存主张、上下文、证明项和工具版本"
          },
          {
            "order": 2,
            "instruction": "由独立内核或等价小检查器检查证明项"
          },
          {
            "order": 3,
            "instruction": "记录检查通过、失败节点和未检查假设"
          },
          {
            "order": 4,
            "instruction": "仅在完整检查通过时把结论标为形式核验"
          }
        ],
        "stop_conditions": [
          "检查器缺失、版本不明或证明项含未声明公理。"
        ],
        "success_conditions": [
          "证明项被独立检查器接受，且假设和版本可重放。"
        ],
        "evidence_required": [
          "主张、证明项摘要、检查器版本、依赖、公理和检查结果。"
        ],
        "failure_modes": [
          "把 tactic 成功输出当成内核证据。",
          "隐藏公理或环境差异。"
        ]
      }
    },
    {
      "id": "psoa.formal-logic-automated-reasoning.formal-reasoning-loop",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "derived",
      "name": "Formal Reasoning Loop",
      "name_zh": "形式推理循环",
      "domain": "formal-logic-automated-reasoning",
      "status": "experimental",
      "summary": "组合形式规约、语义分离、反模型搜索、子目标分解和内核核验，形成先定义后证明的推理闭环。",
      "core_question": "主张能否被形式化、搜索、证明并由独立检查器复核？",
      "operation": "Specify → Separate → Search/Falsify → Decompose → Kernel Check",
      "agent_use": "将高置信语言推理拆成可检查的中间证据。",
      "applicability": {
        "when": [
          "需要对复杂主张给出可审计形式依据。"
        ],
        "not_when": [
          "问题没有稳定形式语义或证据不可重放。"
        ]
      },
      "source_refs": [
        "ref:lean-language-reference",
        "ref:sep-classical-logic",
        "ref:lean-tactic-proofs"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "已有主张、候选定义和可接受的形式化边界。"
        ],
        "steps": [
          {
            "order": 1,
            "use": "psoa.formal-logic-automated-reasoning.formal-problem-specification"
          },
          {
            "order": 2,
            "apply_model": "psoa.formal-logic-automated-reasoning.syntax-semantics-separation"
          },
          {
            "order": 3,
            "use": "psoa.formal-logic-automated-reasoning.satisfiability-countermodel-search"
          },
          {
            "order": 4,
            "use": "psoa.formal-logic-automated-reasoning.proof-state-subgoal-decomposition"
          },
          {
            "order": 5,
            "use": "psoa.formal-logic-automated-reasoning.kernel-checked-proof-evidence"
          }
        ],
        "stop_conditions": [
          "形式化失败、反模型存在、预算耗尽或内核检查不通过。"
        ],
        "success_conditions": [
          "主张有明确语义、无反模型、子目标全部关闭且证据经独立检查。"
        ],
        "evidence_required": [
          "问题规约、模型/反模型搜索、子目标树、证明项和内核结果。"
        ],
        "failure_modes": [
          "把未判定当成证明成功。"
        ]
      }
    }
  ]
}
