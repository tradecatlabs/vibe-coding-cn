{
  "api_version": "vibe-harness-cn.dev/v1alpha1",
  "kind": "OperatorPack",
  "metadata": {
    "id": "psoa.pack.earth-science-geoscience",
    "version": "1.0.0",
    "domain": "earth-science-geoscience",
    "title": "地球科学与地质推理",
    "summary": "把地质观察、空间不确定性、地层排序、剖面建模和地面验证转为证据程序。",
    "source_entry_count": 5,
    "derived_entry_count": 1
  },
  "entries": [
    {
      "id": "psoa.earth-science-geoscience.field-observation-uncertainty",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "source_key": "earth-science-geoscience.field-observation-uncertainty",
      "name": "Field Observation Uncertainty",
      "name_zh": "野外观察不确定性",
      "domain": "earth-science-geoscience",
      "status": "experimental",
      "summary": "把可观察、推断、遮蔽、位置误差和存在置信度作为地质观察的一部分记录。",
      "core_question": "这个特征看到了多少，位置和存在判断有多确定？",
      "operation": "记录观察条件 → 分离可见/推断 → 量化位置区间 → 标记存在与身份置信度",
      "agent_use": "让 Agent 不把稀疏观测外推成精确地质事实。",
      "applicability": {
        "when": [
          "结论来自现场、遥感或稀疏空间观测。"
        ],
        "not_when": [
          "对象位置和存在已由高精度独立测量确定。"
        ]
      },
      "source_refs": [
        "ref:usgs-geologic-map-accuracy",
        "ref:usgs-geologic-map-data-guidelines"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有观测点、特征描述和定位/识别条件。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "记录观测者、时间、尺度、遮挡和底图条件"
          },
          {
            "order": 2,
            "instruction": "区分 observable、inferred、concealed 和可能不存在"
          },
          {
            "order": 3,
            "instruction": "给位置误差、存在置信度和身份置信度留出字段"
          },
          {
            "order": 4,
            "instruction": "把不确定性传播到地图、剖面和结论范围"
          }
        ],
        "stop_conditions": [
          "观测条件或定位误差未知且会改变结论。"
        ],
        "success_conditions": [
          "每个特征都有观察级别、误差范围和推断边界。"
        ],
        "evidence_required": [
          "观测记录、定位误差、置信度、底图/尺度和解释限制。"
        ],
        "failure_modes": [
          "把地图线条当作自然实体。",
          "把精细图形误当高精度测量。"
        ]
      }
    },
    {
      "id": "psoa.earth-science-geoscience.stratigraphic-temporal-ordering",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "source_key": "earth-science-geoscience.stratigraphic-temporal-ordering",
      "name": "Stratigraphic Temporal Ordering",
      "name_zh": "地层时间排序",
      "domain": "earth-science-geoscience",
      "status": "experimental",
      "summary": "用叠覆、切割、化石和相关关系建立相对时间顺序，并把数值年龄与相对年龄分开。",
      "core_question": "哪些地质体先形成、后形成或只是相关而非同龄？",
      "operation": "列地层/切割关系 → 建偏序 → 用化石/数值年龄校准 → 标出缺口与冲突",
      "agent_use": "帮助 Agent 从关系证据构建时间序列而不是凭叙述排序。",
      "applicability": {
        "when": [
          "有层序、切割关系、化石或年龄数据。"
        ],
        "not_when": [
          "关系被完全扰乱且没有可用独立约束。"
        ]
      },
      "source_refs": [
        "ref:usgs-geologic-time-relative",
        "ref:usgs-stratigraphic-code"
      ],
      "governance": {
        "risk_level": "low",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "对象、关系类型和时间证据已列出。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "记录 superposition、cross-cutting、overlap 和 correlation 关系"
          },
          {
            "order": 2,
            "instruction": "构造从老到新的偏序图并标识不适用关系"
          },
          {
            "order": 3,
            "instruction": "用化石或数值年龄做独立校准而非替代关系"
          },
          {
            "order": 4,
            "instruction": "记录冲突、缺失和只能相对排序的部分"
          }
        ],
        "stop_conditions": [
          "关键接触关系冲突或年龄误差覆盖全部候选顺序。"
        ],
        "success_conditions": [
          "时间偏序、校准依据和不可排序部分清楚。"
        ],
        "evidence_required": [
          "地层/切割关系、化石/数值年龄、校准误差和偏序图。"
        ],
        "failure_modes": [
          "把相对年龄当精确日期。",
          "忽略构造变形后叠覆不适用。"
        ]
      }
    },
    {
      "id": "psoa.earth-science-geoscience.geologic-map-cross-section",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "source_key": "earth-science-geoscience.geologic-map-cross-section",
      "name": "Geologic Map and Cross Section",
      "name_zh": "地质图与剖面一致性",
      "domain": "earth-science-geoscience",
      "status": "experimental",
      "summary": "把平面地图、剖面、单元边界和地质历史放在同一几何与时间模型中互相约束。",
      "core_question": "地图与剖面是否描述同一套空间关系和地质历史？",
      "operation": "统一单元/符号 → 对齐剖面线 → 构造剖面 → 检查几何、拓扑、时间一致性",
      "agent_use": "用多视图交叉检查空间解释，暴露隐藏的几何矛盾。",
      "applicability": {
        "when": [
          "有地图单元、剖面线和空间/时间解释。"
        ],
        "not_when": [
          "数据只支持单点描述且没有空间外推。"
        ]
      },
      "source_refs": [
        "ref:usgs-geologic-map-data-guidelines",
        "ref:usgs-geologic-cross-section-review"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "地图单元、比例尺、剖面线和边界关系已定义。"
        ],
        "inputs": [
          "map_units",
          "contacts",
          "section_line",
          "scale",
          "interpretation"
        ],
        "procedure": [
          "统一地图与剖面的单元名称、符号和比例",
          "沿剖面线投影观测和边界",
          "检查接触、断层、叠覆和厚度关系",
          "把几何不一致回溯到观测或解释层"
        ],
        "effect": {
          "state": "geologic_views_consistent",
          "statement": "形成带比例、边界关系和不一致定位的地图/剖面模型。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "地图、剖面、比例/垂向夸张、单元表、矛盾清单和来源。"
        ],
        "failure_modes": [
          "剖面垂向夸张未声明。",
          "把制图构造线误当自然边界。"
        ],
        "recovery": [
          "回到原始观测、调整剖面解释或保留不确定带。"
        ]
      }
    },
    {
      "id": "psoa.earth-science-geoscience.mass-balance-reservoir-accounting",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "source_key": "earth-science-geoscience.mass-balance-reservoir-accounting",
      "name": "Mass Balance Reservoir Accounting",
      "name_zh": "物质平衡与储层收支",
      "domain": "earth-science-geoscience",
      "status": "experimental",
      "summary": "在明确储层边界、输入输出、压力和孔隙参数后做物质收支，并把假设与区间传递到容量估计。",
      "core_question": "系统内物质从哪里来、到哪里去，收支残差说明什么？",
      "operation": "定边界 → 列储存/通量 → 统一单位与状态 → 计算平衡 → 做敏感性和区间审计",
      "agent_use": "将地学估计从单一数字改成有边界和假设的收支模型。",
      "applicability": {
        "when": [
          "系统边界、储存量、通量和状态参数可估计。"
        ],
        "not_when": [
          "边界交换完全未知且无法给出范围。"
        ]
      },
      "source_refs": [
        "ref:usgs-material-balance-storage",
        "ref:nist-measurement-uncertainty"
      ],
      "governance": {
        "risk_level": "high",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "边界、初末状态、通量、单位和参数区间已声明。"
        ],
        "inputs": [
          "system_boundary",
          "initial_state",
          "final_state",
          "flows",
          "parameter_ranges"
        ],
        "procedure": [
          "定义储层/系统边界和适用收支假设",
          "列生产、注入、储存、泄漏和外部支持项",
          "统一压力、体积、饱和度等单位并计算残差",
          "用区间和敏感性检查主要不确定来源"
        ],
        "effect": {
          "state": "material_balance_bounded",
          "statement": "形成带参数区间、收支残差和适用假设的估计。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "边界、方程、数据来源、单位、参数区间、残差和敏感性。"
        ],
        "failure_modes": [
          "忽略外部支持导致容量高估。",
          "把模型估计写成实测储量。"
        ],
        "recovery": [
          "扩大边界、补测通量或将结果降为范围估计。"
        ]
      }
    },
    {
      "id": "psoa.earth-science-geoscience.remote-sensing-ground-truth",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "source_key": "earth-science-geoscience.remote-sensing-ground-truth",
      "name": "Remote Sensing Ground Truth",
      "name_zh": "遥感地面验证",
      "domain": "earth-science-geoscience",
      "status": "experimental",
      "summary": "用地面或现场检查验证遥感解译的光谱、空间和形态含义，并考虑采集时间差。",
      "core_question": "图像中的类别或变化是否在现实地面可重复观察？",
      "operation": "定义解译主张 → 选验证样点 → 对照地面事实 → 统计错分与时间差 → 修正解译",
      "agent_use": "避免把模型分类或图像纹理直接当现实对象。",
      "applicability": {
        "when": [
          "遥感结果需要现实地面解释或分类验证。"
        ],
        "not_when": [
          "没有可访问的验证对象且只能声明未验证。"
        ]
      },
      "source_refs": [
        "ref:usgs-remote-sensing-verification",
        "ref:usgs-landsat-calibration-validation"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有遥感产品、解译规则和可比较的地面/现场证据。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "定义类别、变化主张、空间尺度和成像时间"
          },
          {
            "order": 2,
            "instruction": "按类别、地形和不确定区选择验证样点"
          },
          {
            "order": 3,
            "instruction": "记录地面观察、位置误差和影像到验证的时间差"
          },
          {
            "order": 4,
            "instruction": "计算错分/漏检并修正解译或降低结论范围"
          }
        ],
        "stop_conditions": [
          "地面事实与影像时间/尺度不可比，或验证覆盖不足。"
        ],
        "success_conditions": [
          "解译主张有地面证据、误差和适用范围。"
        ],
        "evidence_required": [
          "影像版本、解译规则、样点、地面记录、混淆/误差和时间差。"
        ],
        "failure_modes": [
          "地面变化被误当算法错误。",
          "验证样点只覆盖容易案例。"
        ]
      }
    },
    {
      "id": "psoa.earth-science-geoscience.geoscience-inference-loop",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "derived",
      "name": "Geoscience Inference Loop",
      "name_zh": "地学推理循环",
      "domain": "earth-science-geoscience",
      "status": "experimental",
      "summary": "组合观察不确定性、时间排序、地图剖面、收支和地面验证，形成从稀疏证据到受限地学模型的循环。",
      "core_question": "地学解释是否同时满足观察、空间、时间、收支和独立验证约束？",
      "operation": "Observe Uncertainty → Order Time → Build Views → Balance → Ground Truth",
      "agent_use": "把地学推理的外推风险显式放进 Agent 证据链。",
      "applicability": {
        "when": [
          "需要从现场/遥感/地层资料构建地学解释。"
        ],
        "not_when": [
          "问题不含空间、时间或物质过程。"
        ]
      },
      "source_refs": [
        "ref:usgs-geologic-map-accuracy",
        "ref:usgs-stratigraphic-code",
        "ref:usgs-remote-sensing-verification"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "存在可追溯的地学观测和解释目标。"
        ],
        "steps": [
          {
            "order": 1,
            "use": "psoa.earth-science-geoscience.field-observation-uncertainty"
          },
          {
            "order": 2,
            "use": "psoa.earth-science-geoscience.stratigraphic-temporal-ordering"
          },
          {
            "order": 3,
            "use": "psoa.earth-science-geoscience.geologic-map-cross-section"
          },
          {
            "order": 4,
            "use": "psoa.earth-science-geoscience.mass-balance-reservoir-accounting"
          },
          {
            "order": 5,
            "use": "psoa.earth-science-geoscience.remote-sensing-ground-truth"
          }
        ],
        "stop_conditions": [
          "关键观察不确定、空间/时间关系矛盾、收支不闭合或无法验证。"
        ],
        "success_conditions": [
          "模型边界、时间/空间关系、收支和验证状态均有证据。"
        ],
        "evidence_required": [
          "观察置信度、偏序图、地图/剖面、收支和地面验证。"
        ],
        "failure_modes": [
          "稀疏点观测被无条件外推。"
        ]
      }
    }
  ]
}
