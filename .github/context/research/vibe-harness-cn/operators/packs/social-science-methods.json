{
  "api_version": "vibe-harness-cn.dev/v1alpha1",
  "kind": "OperatorPack",
  "metadata": {
    "id": "psoa.pack.social-science-methods",
    "version": "1.0.0",
    "domain": "social-science-methods",
    "title": "社会科学方法",
    "summary": "把研究问题操作化、抽样代表性、质性编码、混合方法三角互证和制度情境分析转为可追溯社会研究程序。",
    "source_entry_count": 5,
    "derived_entry_count": 1
  },
  "entries": [
    {
      "id": "psoa.social-science-methods.research-question-operationalization",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "name": "Research Question Operationalization",
      "name_zh": "研究问题操作化",
      "domain": "social-science-methods",
      "status": "experimental",
      "summary": "把社会概念和价值问题改写成有边界、可观察、可比较并声明测量限制的研究问题。",
      "core_question": "我们究竟研究什么构念、对谁、在何时，以什么指标或材料判断？",
      "operation": "定义构念 → 提出问题/竞争解释 → 选指标与来源 → 对齐边界/偏差",
      "agent_use": "让 Agent 不把价值词、代理指标和真实构念混为一谈。",
      "applicability": {
        "when": [
          "需要把社会问题、概念或价值判断变成可研究问题和指标。"
        ],
        "not_when": [
          "只做价值讨论，不需要观察、比较或行动证据。"
        ]
      },
      "source_refs": [
        "ref:cdc-program-evaluation-2024",
        "ref:cdc-gather-credible-evidence"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "已有现象、目标群体、时间范围和候选概念。"
        ],
        "inputs": [
          "research_problem",
          "constructs",
          "population",
          "outcomes",
          "context"
        ],
        "procedure": [
          "把概念定义成可区分的构念和边界",
          "提出可证伪、可回答的研究问题与竞争解释",
          "为每个构念选择指标、数据来源、时间窗和单位",
          "记录哪些部分无法操作化以及可能的测量偏差"
        ],
        "effect": {
          "state": "social_research_question_operationalized",
          "statement": "形成构念、指标、研究问题、样本和测量限制的对齐表。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "构念定义、研究问题、指标、数据来源、时间窗、测量误差与不可测部分。"
        ],
        "failure_modes": [
          "把价值词直接当指标。",
          "指标可测但不代表目标构念。"
        ],
        "recovery": [
          "补充概念分析、替代指标和利益相关者解释，降低结论范围。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "representation",
          "secondary_classes": [
            "verification-falsification"
          ]
        }
      },
      "source_key": "social-science-methods.research-question-operationalization"
    },
    {
      "id": "psoa.social-science-methods.sampling-and-representation-audit",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "name": "Sampling and Representation Audit",
      "name_zh": "抽样与代表性审计",
      "domain": "social-science-methods",
      "status": "experimental",
      "summary": "检查目标总体、抽样框、覆盖、无应答、缺失和群体差异，限定可推断范围。",
      "core_question": "这批数据代表谁，遗漏谁，哪些群体不能从中推断？",
      "operation": "Define Population → Audit Sample → Compare Coverage → Bound Inference",
      "agent_use": "避免大样本、平均值或便利样本制造虚假普遍性。",
      "applicability": {
        "when": [
          "需要从有限数据推断群体、比较群体或评价代表性。"
        ],
        "not_when": [
          "只描述已知全体数据，且不存在抽样、缺失或群体差异。"
        ]
      },
      "source_refs": [
        "ref:cdc-gather-credible-evidence",
        "ref:cdc-evaluation-standards"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有目标总体、抽样框或明确说明其缺失。"
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "定义目标总体、纳入/排除边界、抽样单位和推断范围"
          },
          {
            "order": 2,
            "instruction": "检查抽样机制、覆盖误差、无应答、缺失、流失和便利样本偏差"
          },
          {
            "order": 3,
            "instruction": "比较样本与目标总体在关键维度上的分布与缺口"
          },
          {
            "order": 4,
            "instruction": "把代表性限制、加权/分层假设和不可推断群体写入结论"
          }
        ],
        "stop_conditions": [
          "目标总体或抽样机制未知，且代表性会改变决策。",
          "关键群体严重缺失而无法补救。"
        ],
        "success_conditions": [
          "总体、样本、抽样机制、缺失、代表性证据和推断边界明确。"
        ],
        "evidence_required": [
          "总体/抽样框、样本流、覆盖和无应答分析、群体比较、推断限制。"
        ],
        "failure_modes": [
          "把样本量大误当代表性好。",
          "用平均值掩盖少数群体缺失。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "verification-falsification",
          "secondary_classes": [
            "representation",
            "control-metacognition"
          ]
        }
      },
      "source_key": "social-science-methods.sampling-and-representation-audit"
    },
    {
      "id": "psoa.social-science-methods.qualitative-coding-comparison",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "name": "Qualitative Coding and Comparison",
      "name_zh": "质性编码与比较",
      "domain": "social-science-methods",
      "status": "experimental",
      "summary": "对访谈、观察和文本进行可追溯编码，比较案例、群体、时间与反例，保留研究者位置。",
      "core_question": "哪些主题由原始材料支持，哪些只是解释，哪些反例改变了模式？",
      "operation": "定义编码 → 保留上下文 → 比较案例/负例 → 审计分歧与代码演化",
      "agent_use": "让 Agent 不只摘支持性引文，也要呈现反例和编码依据。",
      "applicability": {
        "when": [
          "需要从访谈、观察、文本或开放回答中归纳主题和机制。"
        ],
        "not_when": [
          "数据没有文本/观察内容，或问题只要求数值估计。"
        ]
      },
      "source_refs": [
        "ref:ukri-qualitative-research",
        "ref:cdc-gather-credible-evidence"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有编码单位、研究问题和至少一批可追溯质性材料。"
        ],
        "inputs": [
          "qualitative_data",
          "coding_scheme",
          "research_question",
          "coder_context"
        ],
        "procedure": [
          "定义编码单位和研究问题相关的初始代码",
          "对材料进行开放/聚焦编码，保留原文证据与上下文",
          "比较案例、群体和时间段的共同点、差异、反例和负例",
          "记录代码演化、研究者位置、分歧和未饱和主题"
        ],
        "effect": {
          "state": "qualitative_patterns_compared",
          "statement": "形成带原文证据、案例比较、反例和编码审计轨迹的质性模式。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "编码规则、样本片段、代码本、案例矩阵、分歧/负例和研究者反思。"
        ],
        "failure_modes": [
          "只摘支持性引文。",
          "把研究者解释伪装成参与者原话。"
        ],
        "recovery": [
          "回到原始材料、引入第二编码者或负例审查，并缩小主题。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "diagnosis-revision",
          "secondary_classes": [
            "verification-falsification",
            "representation"
          ]
        }
      },
      "source_key": "social-science-methods.qualitative-coding-comparison"
    },
    {
      "id": "psoa.social-science-methods.mixed-methods-triangulation",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "source",
      "name": "Mixed-Methods Triangulation",
      "name_zh": "混合方法三角互证",
      "domain": "social-science-methods",
      "status": "experimental",
      "summary": "让定量、质性和多来源证据各自回答适合的问题，再对照一致、互补、矛盾和不可比之处。",
      "core_question": "不同方法到底在回答同一个问题的哪一部分，差异是错误还是机制线索？",
      "operation": "Align Questions → Assign Methods → Compare → Explain Divergence → Synthesize",
      "agent_use": "避免把方法多数票当作真理，保留差异的解释价值。",
      "applicability": {
        "when": [
          "一个社会问题需要同时理解规模/关系和意义/机制。"
        ],
        "not_when": [
          "问题只需单一方法即可回答，或没有可互补的数据来源。"
        ]
      },
      "source_refs": [
        "ref:cdc-program-evaluation-2024",
        "ref:national-academies-mixed-methods"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "有相互补充的定量、定性或多来源证据问题。"
        ],
        "steps": [
          {
            "order": 1,
            "use": "psoa.social-science-methods.research-question-operationalization"
          },
          {
            "order": 2,
            "instruction": "分别说明每种方法回答什么、不能回答什么及其误差来源"
          },
          {
            "order": 3,
            "use": "psoa.social-science-methods.qualitative-coding-comparison"
          },
          {
            "order": 4,
            "instruction": "对照结果，区分一致、互补、矛盾和不可比之处"
          },
          {
            "order": 5,
            "instruction": "将综合结论限定在跨方法共同支持或能解释差异的范围"
          }
        ],
        "stop_conditions": [
          "方法回答的是不同问题，却被强行合并为一个数字。",
          "关键矛盾无法解释且会改变行动。"
        ],
        "success_conditions": [
          "研究问题、方法角色、证据融合、矛盾和综合边界清晰。"
        ],
        "evidence_required": [
          "问题—方法矩阵、各方法结果、样本/测量限制、对照表和综合结论。"
        ],
        "failure_modes": [
          "把三角验证理解为多数结果一致。",
          "忽视方法间不可比和权力/语境差异。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "verification-falsification",
          "secondary_classes": [
            "representation",
            "diagnosis-revision"
          ]
        }
      },
      "source_key": "social-science-methods.mixed-methods-triangulation"
    },
    {
      "id": "psoa.social-science-methods.stakeholder-institutional-context",
      "version": "1.0.0",
      "kind": "OperatorSpec",
      "origin": "source",
      "name": "Stakeholder and Institutional Context",
      "name_zh": "利益相关者与制度情境",
      "domain": "social-science-methods",
      "status": "experimental",
      "summary": "把行动者、组织规则、权力、激励、执行能力和二阶后果纳入研究解释。",
      "core_question": "结果由谁在什么制度和激励下执行，哪些情境变化会让建议失效？",
      "operation": "列行动者/规则 → 画激励与权力 → 检查执行反馈 → 标记迁移边界",
      "agent_use": "让 Agent 不把个体行为和统计关联脱离制度环境。",
      "applicability": {
        "when": [
          "研究结果会影响组织、制度、政策或群体关系。"
        ],
        "not_when": [
          "没有组织、制度、权力、资源分配或实施环境。"
        ]
      },
      "source_refs": [
        "ref:cdc-program-evaluation-2024",
        "ref:ukri-qualitative-research"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "已识别行动主体、制度规则和实施场景。"
        ],
        "inputs": [
          "stakeholders",
          "institutions",
          "rules",
          "incentives",
          "implementation_context"
        ],
        "procedure": [
          "列出参与者、组织、制度规则、资源和激励",
          "画出正式规则与非正式规范如何影响行为和结果",
          "检查权力不对称、执行能力、反馈和意外后果",
          "把情境依赖和可迁移边界写入建议"
        ],
        "effect": {
          "state": "institutional_context_profiled",
          "statement": "形成把利益相关者、制度、激励、执行和二阶后果连接起来的情境画像。"
        },
        "outcomes": [
          "succeeded",
          "inconclusive",
          "blocked",
          "failed"
        ],
        "evidence_required": [
          "参与者/制度图、规则与激励、执行约束、权力差异和二阶后果。"
        ],
        "failure_modes": [
          "把个体选择当作脱离制度的原因。",
          "复制在一个机构有效的建议而不检查情境。"
        ],
        "recovery": [
          "补充组织/制度证据和实施者反馈，缩小可迁移主张。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "representation",
          "secondary_classes": [
            "causal-inference",
            "control-metacognition"
          ]
        }
      },
      "source_key": "social-science-methods.stakeholder-institutional-context"
    },
    {
      "id": "psoa.social-science-methods.social-science-inquiry-loop",
      "version": "1.0.0",
      "kind": "MethodSpec",
      "origin": "derived",
      "name": "Social Science Inquiry Loop",
      "name_zh": "社会科学探究循环",
      "domain": "social-science-methods",
      "status": "experimental",
      "summary": "组合操作化、代表性审计、质性比较、混合方法综合和制度情境，形成可审查研究结论。",
      "core_question": "这个社会研究结论是否同时经得起构念、样本、方法、制度和推断边界审查？",
      "operation": "Operationalize → Sample → Code → Triangulate → Contextualize",
      "agent_use": "作为 Agent 评估政策、组织干预和社会现象的研究流程。",
      "applicability": {
        "when": [
          "需要对社会现象、政策或组织干预形成可审查的研究结论。"
        ],
        "not_when": [
          "只做描述性事实检索，且没有研究设计或行动建议。"
        ]
      },
      "source_refs": [
        "ref:cdc-program-evaluation-2024",
        "ref:cdc-gather-credible-evidence",
        "ref:national-academies-mixed-methods"
      ],
      "governance": {
        "risk_level": "medium",
        "permission_decision": "harness_policy",
        "outcome_decision": "verifier",
        "sensitive_values": "reference_only"
      },
      "semantics": {
        "preconditions": [
          "研究问题、总体、指标/材料和决策用途已声明。"
        ],
        "steps": [
          {
            "order": 1,
            "use": "psoa.social-science-methods.research-question-operationalization"
          },
          {
            "order": 2,
            "use": "psoa.social-science-methods.sampling-and-representation-audit"
          },
          {
            "order": 3,
            "use": "psoa.social-science-methods.qualitative-coding-comparison"
          },
          {
            "order": 4,
            "use": "psoa.social-science-methods.mixed-methods-triangulation"
          },
          {
            "order": 5,
            "use": "psoa.social-science-methods.stakeholder-institutional-context"
          }
        ],
        "stop_conditions": [
          "代表性、测量或情境证据不足以支撑决策。",
          "定量/质性矛盾未解释，或利益相关者被系统排除。"
        ],
        "success_conditions": [
          "构念、样本、方法、证据融合、制度情境和推断边界可追溯。"
        ],
        "evidence_required": [
          "操作化表、抽样审计、编码矩阵、混合方法综合、制度情境和限制。"
        ],
        "failure_modes": [
          "把相关、叙事或单次调查写成普遍因果。",
          "忽略制度执行和群体权力导致建议失效。"
        ]
      },
      "extensions": {
        "vibe-harness-cn": {
          "functional_class": "control-metacognition",
          "secondary_classes": [
            "representation",
            "verification-falsification"
          ]
        }
      }
    }
  ]
}
