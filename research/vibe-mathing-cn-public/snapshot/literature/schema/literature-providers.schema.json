{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecatlabs.com/vibe-mathing/schema/literature-providers.schema.json",
  "title": "Vibe Mathing Literature Provider Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "providers"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "base_url",
          "query_parameter",
          "response_format",
          "extra_query",
          "auth",
          "contact",
          "timeout_seconds",
          "max_retries",
          "max_response_bytes"
        ],
        "properties": {
          "id": {"enum": ["arxiv", "crossref", "openalex", "semantic-scholar"]},
          "base_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "query_parameter": {"type": "string", "minLength": 1},
          "response_format": {"enum": ["atom", "json"]},
          "extra_query": {
            "type": "object",
            "additionalProperties": {"type": ["string", "integer", "boolean"]}
          },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "name", "env", "required_for_live"],
            "properties": {
              "mode": {"enum": ["none", "query", "header"]},
              "name": {"type": ["string", "null"]},
              "env": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$"},
              "required_for_live": {"type": "boolean"}
            }
          },
          "contact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query_parameter", "env"],
            "properties": {
              "query_parameter": {"type": ["string", "null"]},
              "env": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$"}
            }
          },
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
          "max_retries": {"type": "integer", "minimum": 0, "maximum": 3},
          "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 30000000}
        }
      }
    }
  }
}
