    "id": "psoa.taxonomy.problem-solving-methodology",
    "version": "1.7.0",
    "title": "问题求解算子双轴分类",
    "status": "experimental",
    "summary": "把母领域来源与算子在问题空间中承担的功能分开管理。"
  },
  "spec": {
    "axes": {
      "source_domain": {
        "description": "方法从哪个学科或实践传统中抽取；它说明出处，不决定运行时调用。",
        "values": "open"
      },
      "functional_class": {
        "description": "算子主要改变问题表示、分支、候选、证据或控制状态的方式。",
        "values": [
          "representation",
          "decomposition",
          "transformation",
          "search",
          "construction",
          "verification-falsification",
          "diagnosis-revision",
          "control-metacognition"
        ]
      }
    },
    "categories": [
      {"id": "representation", "name_zh": "表征", "question": "我是不是用错方式理解问题？"},
      {"id": "decomposition", "name_zh": "分解", "question": "怎样把问题拆成可处理的子问题？"},
      {"id": "transformation", "name_zh": "变换", "question": "能否把陌生问题改写成熟悉问题？"},
      {"id": "search", "name_zh": "搜索", "question": "下一条路径或候选应该先探索什么？"},
      {"id": "construction", "name_zh": "构造", "question": "怎样做出可检查的候选或见证？"},
      {"id": "verification-falsification", "name_zh": "验证/证伪", "question": "什么证据支持、限制或推翻当前主张？"},
      {"id": "diagnosis-revision", "name_zh": "诊断/修正", "question": "失败发生在哪里，最小改动是什么？"},
      {"id": "control-metacognition", "name_zh": "控制/元认知", "question": "何时继续、停止、切换、回退或升级？"}
